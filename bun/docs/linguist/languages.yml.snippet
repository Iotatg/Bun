# The entry for the language Bun in the list of the languages of GitHub
# Linguist.  The file lives at `lib/linguist/languages.yml` in the
# repository `github-linguist/linguist`; the entry is added in the
# alphabetical place, between `Bump` and `C` (or wherever the name fits
# when the pull request is opened).
#
# The `language_id` is a number that the maintainers of Linguist hand
# out, so the number here is a placeholder: replace it with the one the
# maintainers give.  A number that is already taken makes the test of
# Linguist fail, so the placeholder is the first free number in the
# 1067292665 range.
Bun:
  type: programming
  color: "#7aa2f7"
  extensions:
  - ".bun"
  tm_scope: source.bun
  ace_mode: text
  codemirror_mode: ruby
  codemirror_mime_type: text/x-ruby
  language_id: 1067292665
