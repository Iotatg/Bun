export fn review_response() {
    return [
        {"point": 1, "topic": "ETH equivalence too strong (liminf)",
         "response": "ACCEPTED — real bug", "action": "liminf -> limsup; De Morgan complement mismatch recorded; uniformity lemma made explicit",
         "evidence": "level2_review() = REJECTED, level3_fix_check() = COMPLEMENTARY"},
        {"point": 2, "topic": "CERTIFIED 10/10 means self-checks, not ETH",
         "response": "ACCEPTED — clarified", "action": "scope field on every certificate; scope-overclaim is a planted false positive",
         "evidence": "certificate l2-audit-proves-eth -> REJECTED"},
        {"point": 3, "topic": "2026 AI claims: UNDER_REVIEW is correct",
         "response": "ACCEPTED — kept", "action": "journalism/panel/Lean-gap all modelled as false positives",
         "evidence": "can_settle('shabda','universal-algorithm') = false"},
        {"point": 4, "topic": "BBBV is a black-box bound, not a 3SAT bound",
         "response": "ACCEPTED — enforced", "action": "reduction bbbv-to-3sat is INVALID on model-restriction and total-map",
         "evidence": "bbbv_transfer().verdict = INVALID"},
        {"point": 5, "topic": "tests written != tests executed; metadata != proof",
         "response": "ACCEPTED — externalised", "action": "execution_receipt() refuses self-verification; the lab prints an actual pytest run",
         "evidence": "NYAYA_LAB_OUTPUT.txt + report carry the real suite numbers"}
    ]
}

// ---------------------------------------------------------------------------
// 9. Execution receipts and honest scope
// ---------------------------------------------------------------------------

export fn execution_receipt() {
    return {"self_verifiable": false,
            "statement": "nyaya cannot verify that its own tests were executed",
            "required": "an external `python3 -m pytest -q` run with four-engine parity",
            "why": "a certificate about an execution is pratyaksha (measurement); the verifier cannot be both witness and judge",
            "record": "the real numbers are pasted into NYAYA_REPORT.md from the run, not asserted by this module"}
}

export fn settle_conditions() {
    return [
        "an explicit algorithm A",
        "a worst-case bound T_A(n) = 2^o(n), i.e. s_A(n) -> 0, proved for EVERY instance",
        "a proof that the bound holds for all n beyond some N (limsup = 0), not only on a subsequence",
        "premises independently checked, and the NL theorem matched to the formal statement",
        "human verification of the argument, not only a Lean kernel or a press release",
        "uniformity: if only 'for every A limsup > 0' is at stake, state the triangular diagonalisation assumption"
    ]
}

export fn nyaya_verdict() {
    let a = audit()
    let mv = mystery_verdict()
    return {"eth": mv["eth"], "mystery": mv["mystery"],
            "level2_bug": "SOLVED (liminf -> limsup, De Morgan verified)",
            "level3": a["verdict"] + " " + num(float(a["passed"])) + "/" + num(float(a["total"])),
            "solved": ["why ETH stays unresolved", "which pramana can settle which claim type",
                       "the alpha invariant error", "the liminf theorem-statement error",
                       "the quantum model restriction", "false-positive certificate detection"],
            "not_solved": ["ETH itself (proved or refuted)", "the 2026 AI claims (UNDER_REVIEW)",
                           "a worst-case 2^o(n) algorithm", "a self-certifying verifier"],
            "self_challenged": self_challenge()["verdict"] == "SELF_CHALLENGE_PASSED"}
}

// ---------------------------------------------------------------------------
// 10. Self-audit — includes checks that try to break this module
// ---------------------------------------------------------------------------

export fn audit() {
    let checks = []
    let dm = complement_check("limsup-positive", "s-to-zero")
    checks.push({"check": "de-morgan-engine", "pass": dm["complementary"],
                 "detail": "not(limsup>0) = " + dm["correct_prefix"]})
    let l2 = level2_review()
    checks.push({"check": "level2-pair-rejected", "pass": l2["verdict"] == "REJECTED",
                 "detail": "claimed " + l2["claimed_negation_prefix"] + ", correct " + l2["correct_negation_prefix"]})
    let l3 = level3_fix_check()
    checks.push({"check": "level3-fix-complementary", "pass": l3["complementary"],
                 "detail": "live bun:eth pair " + str(l3["pair"]) + " is complementary"})
    var uniform_ok = true
    for need in uniformity_lemma()["needs"] {
        if not assumption_check(need)["eth_grants"] { uniform_ok = false }
    }
    checks.push({"check": "uniformity-assumptions", "pass": uniform_ok,
                 "detail": "worst-case, enumeration, triangular are all declared ETH-granted"})
    checks.push({"check": "monotone-not-eth-axiom",
                 "pass": not assumption_check("monotone-runtime")["eth_grants"],
                 "detail": "the assumption needed for liminf>0 is explicitly NOT granted by ETH"})
    let cr = challenge_rules()
    checks.push({"check": "witness-counterexample",
                 "pass": cr["old_errors"] >= 1 and cr["breaking_witness"] == "sparse-dips",
                 "detail": cr["breaking_witness"] + " breaks the liminf rule while limsup = 0.5"})
    checks.push({"check": "corrected-rule-survives", "pass": cr["new_errors"] == 0,
                 "detail": "limsup rule matches all " + num(float(cr["witnesses"])) + " witnesses"})
    var red_ok = true
    for r in reduction_all() {
        if r["id"] == "sparsification" and r["verdict"] != "VALID" { red_ok = false }
        if r["id"] == "naive-branching" and r["verdict"] != "INVALID" { red_ok = false }
        if r["id"] == "bbbv-to-3sat" and r["verdict"] != "INVALID" { red_ok = false }
    }
    checks.push({"check": "reduction-correctness", "pass": red_ok,
                 "detail": "sparsification VALID; fixed-eps branching and BBBV transfer INVALID"})
    checks.push({"check": "quantum-model-bound", "pass": not bbbv_transfer()["model_ok"],
                 "detail": "Grover s = 0.5 > 0; BBBV restricted to the black-box model"})
    let fps = false_positive_scan()
    checks.push({"check": "false-positives-caught", "pass": fps["all_caught"],
                 "detail": num(float(fps["caught"])) + "/" + num(float(fps["total"])) + " rejected, including two issued by Level 2"})
    let sc = self_challenge()
    checks.push({"check": "self-challenge", "pass": sc["verdict"] == "SELF_CHALLENGE_PASSED",
                 "detail": "nyaya rejects its own certificate and accepts the corrected theorem"})
    checks.push({"check": "eth-unresolved", "pass": mystery_verdict()["eth"] == "UNRESOLVED",
                 "detail": "no claim in this module proves or refutes ETH"})
    checks.push({"check": "execution-not-self-verified",
                 "pass": not execution_receipt()["self_verifiable"],
                 "detail": "test execution requires an external pratyaksha receipt"})
    var passed = 0
    for c in checks { if c["pass"] { passed = passed + 1 } }
    return {"verdict": pick(passed == checks.len(), "CERTIFIED", "FAILED"),
            "passed": passed, "total": checks.len(), "checks": checks}
}

