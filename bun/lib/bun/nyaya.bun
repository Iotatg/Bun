export fn lesson() {
    return [
        "Level 3 (grad year 4): पहले अपने निष्कर्ष पर शक करो, फिर दूसरों पर।",
        "1. Theorem ko quantifier-prefix me likho: E eps, A N, E n — poora order matter karta hai.",
        "2. De Morgan lagao: har quantifier aur relation palto. Kya 'negation' sach me complement hai?",
        "3. Assumption ledger banao: kaun-si cheez ETH deti hai, kaun-si tumne chupke se maan li?",
        "4. Counterexample dhoondo: ek aisa algorithm jiski s(n) kabhi-kabhi girati ho par -> 0 na ho.",
        "5. Reduction ki total-map, answer-preservation, size, time, all-eps aur model alag-alag check karo.",
        "6. Formal proof aur natural-language theorem ke beech ka gap explicitly likho (Lean gap).",
        "7. Apne hi module ka certificate reject karke dikhao — warna verifier nahi, cheerleader hai.",
        "8. Ant: ETH UNRESOLVED. Level 3 ne ETH nahi, apni galati solve ki. Yahi asli power hai."
    ]
}
