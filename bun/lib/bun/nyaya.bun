// bun:nyaya — SUTRA Level 3: a verifier that challenges its own conclusions.
//
//   Level 1  bun:sutra      "क्या आकार है?"            shape
//   Level 2  bun:pramana    "कौन-सा प्रमाण तय करेगा?"   evidence
//   Level 3  bun:nyaya      "क्या मेरा निष्कर्ष सही है?" self-challenge
//
// Nyaya does NOT prove ETH. It verifies THEOREM STATEMENTS: quantifier order,
// asymptotic bounds, proof assumptions, reduction correctness, the gap
// between a formal proof and the natural-language theorem it is said to
// prove, and — the whole point — false-positive certificates. Two of the
// certificates it must reject were issued by Level 2, and one by nyaya
// itself. A verifier that cannot reject its own output is not a verifier.
//
// Origin: an external code review of public commit d43dec0
// (Iotatg/Bun, Main, 8 files, 1538+/2-) pointed out that Level 2 wrote
//
//     ETH true  <=>  liminf s(n) > 0 for every correct algorithm
//
// which is STRICTLY STRONGER than ETH. This module proves that mechanically
// (De Morgan negation of the quantifier prefix) and checks the fix.

import { num, fmt, has_key } from "bun:sutra"
import { eth_statement } from "bun:eth"
import { can_settle, mystery_verdict } from "bun:pramana"

let M = ffi_load("math")
let f_log = M["log"]
let f_abs = M["fabs"]
let f_sqrt = M["sqrt"]
let LN2 = f_log(2.0)

fn pick(c, a, b) {
    if c { return a }
    return b
}

// ---------------------------------------------------------------------------
// 1. Formal statements as quantifier prefixes
//
// For s(n) >= 0, every asymptotic statement about ETH is a triple of
// quantifiers over (eps, N, n>=N) followed by a relation:
//
//   liminf s > 0 :  E eps  E N  A n : s(n) >= eps
//   limsup s > 0 :  E eps  A N  E n : s(n) >= eps
//   s(n) -> 0    :  A eps  E N  A n : s(n) <  eps
//
// De Morgan negation = flip every quantifier AND flip the relation. No
// interpretation, no prose, no judgement: pure symbol manipulation.
// ---------------------------------------------------------------------------

fn flip_q(q) {
    if q == "exists" { return "forall" }
    return "exists"
}

fn flip_rel(r) {
    if r == ">=" { return "<" }
    return ">="
}

fn mk(id, text, qs, rel, meaning) {
    return {"id": id, "text": text, "qs": qs, "rel": rel, "meaning": meaning}
}

export fn statements() {
    return [
        mk("liminf-positive", "forall A: liminf_n s_A(n) > 0",
           ["exists", "exists", "forall"], ">=",
           "hardness at EVERY sufficiently large input length"),
        mk("limsup-positive", "forall A: limsup_n s_A(n) > 0",
           ["exists", "forall", "exists"], ">=",
           "hardness at infinitely many input lengths (s does not tend to 0)"),
        mk("s-to-zero", "exists A: s_A(n) -> 0   [T = 2^o(n)]",
           ["forall", "exists", "forall"], "<",
           "a genuinely subexponential correct algorithm"),
        mk("liminf-zero", "exists A: liminf_n s_A(n) = 0",
           ["forall", "forall", "exists"], "<",
           "a subsequence of easy lengths only; NOT an ETH refutation")
    ]
}

fn find_stmt(id) {
    for s in statements() {
        if s["id"] == id { return s }
    }
    return statements()[0]
}

export fn negate(s) {
    var qs = []
    for q in s["qs"] { qs.push(flip_q(q)) }
    return {"id": "not(" + s["id"] + ")", "text": "negation of " + s["id"],
            "qs": qs, "rel": flip_rel(s["rel"]),
            "meaning": "De Morgan negation of " + s["id"]}
}

export fn equivalent(a, b) {
    if a["rel"] != b["rel"] { return false }
    if a["qs"].len() != b["qs"].len() { return false }
    for i in range(0, a["qs"].len()) {
        if a["qs"][i] != b["qs"][i] { return false }
    }
    return true
}

export fn render(s) {
    var out = ""
    for i in range(0, s["qs"].len()) {
        var lab = "eps>0"
        if i == 1 { lab = "N" }
        if i == 2 { lab = "n>=N" }
        var mark = "A"
        if s["qs"][i] == "exists" { mark = "E" }
        if i > 0 { out = out + "  " }
        out = out + mark + " " + lab
    }
    return out + "   :   s(n) " + s["rel"] + " eps"
}

export fn complement_check(claim_id, negation_id) {
    let a = find_stmt(claim_id)
    let b = find_stmt(negation_id)
    let want = negate(a)
    let ok = equivalent(want, b)
    return {"claim": a["text"], "claim_prefix": render(a),
            "claimed_negation": b["text"], "claimed_prefix": render(b),
            "correct_negation": want["meaning"], "correct_prefix": render(want),
            "complementary": ok,
            "verdict": pick(ok, "COMPLEMENTARY", "NOT_COMPLEMENTARY")}
}

// ---------------------------------------------------------------------------
// 2. The Level 2 record, and the challenge against it
// ---------------------------------------------------------------------------

export fn historical_records() {
    return [
        {"commit": "d43dec0", "field": "bun:eth eth_statement().invariant",
         "text": "s = log2(T)/n; ETH true <=> liminf s > 0 for every correct algorithm",
         "stmt": "liminf-positive"},
        {"commit": "d43dec0", "field": "bun:eth eth_statement().equivalent",
         "text": "ETH false <=> some algorithm has s(n) -> 0 (T = 2^o(n))",
         "stmt": "s-to-zero"},
        {"commit": "d43dec0", "field": "docs/reference/eth.md line 178",
         "text": "ETH true <=> liminf s(n) > 0 for every correct 3SAT algorithm",
         "stmt": "liminf-positive"},
        {"commit": "d43dec0", "field": "docs/reference/pramana.md line 68",
         "text": "ETH true <=> har sahi algorithm ke liye liminf s(n) > 0",
         "stmt": "liminf-positive"}
    ]
}

export fn level2_review() {
    let c = complement_check("liminf-positive", "s-to-zero")
    return {"target": "bun:eth / bun:pramana at d43dec0",
            "verdict": pick(c["complementary"], "ACCEPTED", "REJECTED"),
            "complementary": c["complementary"],
            "claim_prefix": c["claim_prefix"],
            "claimed_negation_prefix": c["claimed_prefix"],
            "correct_negation_prefix": c["correct_prefix"],
            "reason": "negation of (liminf > 0) is (liminf = 0), not (s -> 0); the two lines of eth_statement() were not complements",
            "stronger_than_eth": true,
            "why": "liminf > 0 demands hardness at every large n; ETH only demands hardness at infinitely many n"}
}

export fn level3_fix_check() {
    let e = eth_statement()
    let pair = e["statement_pair"]
    let c = complement_check(pair[0], pair[1])
    return {"source": "live bun:eth eth_statement().statement_pair",
            "pair": pair, "complementary": c["complementary"],
            "claim_prefix": c["claim_prefix"],
            "negation_prefix": c["claimed_prefix"],
            "verdict": pick(c["complementary"], "COMPLEMENTARY", "FAILED"),
            "uniformity": e["uniformity"]}
}

// ---------------------------------------------------------------------------
// 3. Assumption ledger
//
// ETH grants some assumptions and not others. A theorem that silently uses a
// non-granted assumption is a false positive even if its algebra is perfect.
// ---------------------------------------------------------------------------

export fn assumptions() {
    return [
        {"id": "worst-case", "text": "T_A(n) = max over ALL instances of size n",
         "eth_grants": true, "note": "ETH is a worst-case statement"},
        {"id": "all-instances", "text": "the bound holds for every instance, not typical ones",
         "eth_grants": true, "note": "average-case hardness would not refute ETH"},
        {"id": "enumeration", "text": "correct algorithms are effectively enumerable",
         "eth_grants": true, "note": "needed for diagonalisation"},
        {"id": "triangular", "text": "a triangular union of correct algorithms is correct",
         "eth_grants": true, "note": "needed only for the uniform exists-eps form"},
        {"id": "forall-eps", "text": "sparsification holds for EVERY eps>0, not one fixed eps",
         "eth_grants": true, "note": "Impagliazzo-Paturi-Zane"},
        {"id": "monotone-runtime", "text": "T_A is monotone up to constants (hardness at EVERY large n)",
         "eth_grants": false, "note": "would be needed to justify liminf>0; NOT an ETH axiom"},
        {"id": "black-box", "text": "the algorithm sees only an oracle predicate",
         "eth_grants": false, "note": "required for BBBV Omega(sqrt N); structured 3SAT is not an oracle"},
        {"id": "independent-check", "text": "the proof is independently checked by humans",
         "eth_grants": false, "note": "2026 AI claims are still UNDER_REVIEW"},
        {"id": "nl-formal-bridge", "text": "the Lean statement matches the natural-language theorem",
         "eth_grants": false, "note": "formal verification checks a derivation, not the premises"}
    ]
}

export fn assumption_check(id) {
    for a in assumptions() {
        if a["id"] == id { return a }
    }
    return {"id": id, "eth_grants": false, "text": "unknown assumption", "note": "absent"}
}

export fn uniformity_lemma() {
    return {"statement": "inf_A limsup_n s_A(n) = 0  =>  exists a 2^o(n) algorithm",
            "method": "triangular diagonalisation: pick A_k with s_{A_k}(n) <= 1/k for n >= N_k; on size n run the largest k with N_k <= n",
            "needs": ["worst-case", "enumeration", "triangular"],
            "grants": "the uniform form  exists eps>0 forall A  limsup s_A >= eps",
            "warning": "Without this lemma, 'for every A limsup > 0' is only a pointwise statement; it does not by itself give one shared eps"}
}

// ---------------------------------------------------------------------------
// 4. Witness sequences — executable counterexamples to bad rules
//
// Points are [k, s] with k = log2(n); working in log space avoids the
// T overflow at n = 2048 that Level 2 already documented.
// ---------------------------------------------------------------------------

fn soft_s(k) {
    return 1.0 / (f_sqrt(float(k) * LN2) * LN2)
}

fn is_square(k) {
    let r = f_sqrt(float(k))
    return f_abs(r - float(int(r))) < 1e-9
}

export fn witnesses() {
    let constant_099 = []
    let grover_050 = []
    let sparse_dips = []
    let soft_exp = []
    let poly_3 = []
    let bench = [[12.0, 0.42], [16.0, 0.55], [20.0, 0.38], [24.0, 0.61],
                 [28.0, 0.47], [32.0, 0.72]]
    for k in range(4, 65) {
        constant_099.push([float(k), 0.99])
        grover_050.push([float(k), 0.5])
        if is_square(k) {
            sparse_dips.push([float(k), 1.0 / float(k)])
        } else {
            sparse_dips.push([float(k), 0.5])
        }
        poly_3.push([float(k), 3.0 * float(k) / (2.0 ** float(k))])
    }
    for k in range(4, 401) {
        soft_exp.push([float(k), soft_s(k)])
    }
    // The analytic labels are mathematical facts about the whole sequence,
    // not estimates from a finite window. `sequence_stats()` below supplies
    // independent numeric evidence that the labels are plausible.
    return [
        {"id": "constant-0.99", "points": constant_099, "is_2o_n": false,
         "liminf": "positive", "tends_zero": false, "truth": "ETH_TRUE",
         "note": "T = 2^(0.99n): s = 0.99, ETH survives"},
        {"id": "grover-0.50", "points": grover_050, "is_2o_n": false,
         "liminf": "positive", "tends_zero": false, "truth": "ETH_TRUE",
         "note": "T = 2^(n/2): s = 0.5, a quadratic speedup does not refute ETH"},
        {"id": "sparse-dips", "points": sparse_dips, "is_2o_n": false,
         "liminf": "zero", "tends_zero": false, "truth": "ETH_TRUE",
         "note": "s = 0.5 except at square k where s = 1/k: liminf = 0 but limsup = 0.5; ETH-compatible"},
        {"id": "finite-bench", "points": bench, "is_2o_n": false,
         "liminf": "undetermined", "tends_zero": false, "truth": "UNDECIDABLE",
         "note": "six noisy measured points; no asymptotic decision is possible from a finite window"},
        {"id": "soft-exp", "points": soft_exp, "is_2o_n": true,
         "liminf": "zero", "tends_zero": true, "truth": "ETH_FALSE",
         "note": "T = exp(n/sqrt(ln n)): s -> 0, i.e. 2^o(n), refutes ETH if proved"},
        {"id": "polynomial-3", "points": poly_3, "is_2o_n": true,
         "liminf": "zero", "tends_zero": true, "truth": "ETH_FALSE",
         "note": "T = n^3: s -> 0, refutes ETH"}
    ]
}

export fn sequence_stats(pts) {
    let n = pts.len()
    var h = int(n / 4)
    if h < 1 { h = 1 }
    var head_hi = 0.0
    var head_lo = 1e30
    for i in range(0, h) {
        if pts[i][1] > head_hi { head_hi = pts[i][1] }
        if pts[i][1] < head_lo { head_lo = pts[i][1] }
    }
    var tail_hi = 0.0
    var tail_lo = 1e30
    for i in range(n - h, n) {
        if pts[i][1] > tail_hi { tail_hi = pts[i][1] }
        if pts[i][1] < tail_lo { tail_lo = pts[i][1] }
    }
    var tends_zero = false
    if head_hi > 0.0 {
        if tail_hi < 0.25 * head_hi { tends_zero = true }
    }
    return {"head_hi": head_hi, "head_lo": head_lo,
            "tail_hi": tail_hi, "tail_lo": tail_lo,
            "liminf_proxy": tail_lo, "limsup_proxy": tail_hi,
            "tends_zero": tends_zero}
}

// The WRONG rule (Level 2): ETH survives iff liminf s > 0.
// It is evaluated on the ANALYTIC label, not on a finite-window estimate:
// estimating a limit from data is a measurement, and a measurement cannot
// decide a universal asymptotic statement. That is exactly the reviewer's
// point 5 and Level 2's own measurement_theorem().
export fn rule_liminf(w) {
    if w["liminf"] == "positive" { return "ETH_TRUE" }
    if w["liminf"] == "undetermined" { return "UNDECIDABLE" }
    return "ETH_FALSE"
}

// The CORRECT rule: ETH survives iff s(n) does NOT tend to 0 (limsup > 0).
export fn rule_limsup(w) {
    if w["truth"] == "UNDECIDABLE" { return "UNDECIDABLE" }
    if w["tends_zero"] { return "ETH_FALSE" }
    return "ETH_TRUE"
}

// Independent numeric corroboration: the measured proxies must not contradict
// the analytic labels. This is evidence, not the decision procedure.
fn numeric_agrees(w, st) {
    var ok = true
    if w["tends_zero"] != st["tends_zero"] { ok = false }
    if w["liminf"] == "positive" {
        if st["liminf_proxy"] <= 0.25 * st["head_hi"] { ok = false }
    }
    if w["liminf"] == "zero" {
        if st["liminf_proxy"] > 0.5 * st["head_hi"] { ok = false }
    }
    return ok
}

export fn challenge_rules() {
    let rows = []
    var old_errors = 0
    var new_errors = 0
    var breaking = ""
    var numeric_all_ok = true
    for w in witnesses() {
        let st = sequence_stats(w["points"])
        let truth = w["truth"]
        let old = rule_liminf(w)
        let now = rule_limsup(w)
        let nagree = numeric_agrees(w, st)
        if not nagree { numeric_all_ok = false }
        var old_bad = false
        var new_bad = false
        if truth != "UNDECIDABLE" {
            if old != truth { old_bad = true }
            if now != truth { new_bad = true }
        }
        if old_bad { old_errors = old_errors + 1 }
        if new_bad { new_errors = new_errors + 1 }
        if old_bad { breaking = w["id"] }
        rows.push({"id": w["id"], "truth": truth, "liminf_rule": old,
                   "limsup_rule": now, "liminf_proxy": st["liminf_proxy"],
                   "limsup_proxy": st["limsup_proxy"],
                   "tends_zero": st["tends_zero"],
                   "numeric_agrees": nagree,
                   "old_error": old_bad, "new_error": new_bad})
    }
    return {"rows": rows, "witnesses": rows.len(),
            "old_errors": old_errors, "new_errors": new_errors,
            "breaking_witness": breaking, "numeric_all_ok": numeric_all_ok,
            "verdict": pick(new_errors == 0 and old_errors > 0 and numeric_all_ok,
                            "CORRECTED_RULE_SURVIVES", "FAILED")}
}

// ---------------------------------------------------------------------------
// 5. Reduction correctness
//
// A reduction transfers an ETH statement only if it is total, answer
// preserving, linear in the number of variables, itself 2^o(n), valid for
// EVERY eps>0, and does not smuggle in a different computational model.
// ---------------------------------------------------------------------------

export fn reductions() {
    return [
        {"id": "sparsification", "from": "3SAT(n, m arbitrary)",
         "to": "3SAT(n, m = O(n))", "map_total": true,
         "answer_preserving": true, "size_linear": true,
         "time_subexp": true, "eps_arbitrary": true, "model_ok": true,
         "note": "Impagliazzo-Paturi-Zane 2001: <= 2^(eps n) sparse formulas, for every eps>0"},
        {"id": "naive-branching", "from": "3SAT(n, m)",
         "to": "2^(0.5n) sparse instances", "map_total": true,
         "answer_preserving": true, "size_linear": true,
         "time_subexp": false, "eps_arbitrary": false, "model_ok": true,
         "note": "a FIXED eps = 0.5 cannot be driven to 0, so no ETH transfer"},
        {"id": "bbbv-to-3sat", "from": "black-box search over N = 2^n",
         "to": "structured 3SAT", "map_total": false,
         "answer_preserving": false, "size_linear": true,
         "time_subexp": true, "eps_arbitrary": true, "model_ok": false,
         "note": "BBBV Omega(sqrt N) is a black-box theorem; 3SAT has visible structure"},
        {"id": "grover-to-3sat", "from": "black-box search",
         "to": "worst-case 3SAT", "map_total": false,
         "answer_preserving": false, "size_linear": true,
         "time_subexp": true, "eps_arbitrary": true, "model_ok": false,
         "note": "Grover gives s = 0.5 > 0 even inside the oracle model"},
        {"id": "eth-implies-pneqnp", "from": "ETH",
         "to": "P != NP", "map_total": true,
         "answer_preserving": true, "size_linear": true,
         "time_subexp": true, "eps_arbitrary": true, "model_ok": true,
         "note": "one-way implication; the converse is not known and is NOT used here"}
    ]
}

export fn reduction_check(r) {
    let checks = []
    checks.push({"check": "total-map", "pass": r["map_total"],
                 "detail": "every source instance maps to a target instance"})
    checks.push({"check": "answer-preserving", "pass": r["answer_preserving"],
                 "detail": "yes maps to yes, no maps to no"})
    checks.push({"check": "linear-size", "pass": r["size_linear"],
                 "detail": "n' = O(n); a superlinear blowup hides the hardness"})
    checks.push({"check": "subexp-reduction", "pass": r["time_subexp"],
                 "detail": "the reduction itself must run in 2^o(n)"})
    checks.push({"check": "all-eps", "pass": r["eps_arbitrary"],
                 "detail": "sparsification must hold for EVERY eps>0"})
    checks.push({"check": "model-restriction", "pass": r["model_ok"],
                 "detail": "no unjustified transfer from an oracle model to structured 3SAT"})
    checks.push({"check": "worst-case", "pass": r["answer_preserving"],
                 "detail": "the bound is worst-case over all instances"})
    var failed = []
    var passed = 0
    for c in checks {
        if c["pass"] { passed = passed + 1 }
        if not c["pass"] { failed.push(c["check"]) }
    }
    return {"id": r["id"], "note": r["note"], "checks": checks,
            "passed": passed, "total": checks.len(), "failed": failed,
            "verdict": pick(failed.len() == 0, "VALID", "INVALID")}
}

export fn reduction_all() {
    let rows = []
    for r in reductions() { rows.push(reduction_check(r)) }
    return rows
}

export fn bbbv_transfer() {
    let r = reduction_check(reductions()[2])
    return {"model_ok": false, "verdict": r["verdict"],
            "quantum_s": 0.5,
            "statement": "BBBV 1997: Omega(sqrt N) queries are necessary for unstructured black-box search",
            "restriction": "valid ONLY in the black-box model; it is not a lower bound for structured 3SAT",
            "eth_effect": "Grover gives s = 0.5 > 0, so even the quantum speedup does not refute ETH"}
}

// ---------------------------------------------------------------------------
// 6. Formal proof vs natural-language theorem
//
// A Lean file checks a derivation from premises. It does not check that the
// premises match the English theorem, nor that the theorem is about ALL
// algorithms. Those gaps are where false positives are born.
// ---------------------------------------------------------------------------

export fn translation_table() {
    return [
        {"id": "forall-alg", "phrase": "no algorithm solves 3SAT in 2^o(n) time",
         "formal": "forall A, forall x: s_A(n) does not tend to 0", "gap": false,
         "why": "the formal and natural-language statements match"},
        {"id": "worst-case", "phrase": "worst case",
         "formal": "forall instances; T = max", "gap": false,
         "why": "explicit quantifier"},
        {"id": "all-eps", "phrase": "for every eps>0",
         "formal": "A eps", "gap": false, "why": "explicit quantifier"},
        {"id": "lean", "phrase": "Lean 4 verified",
         "formal": "(no mathematical token)", "gap": true,
         "why": "checks a derivation from premises, not the premises or the NL<->formal bridge"},
        {"id": "press", "phrase": "press release / news coverage",
         "formal": "(no mathematical token)", "gap": true,
         "why": "testimony cannot settle a forall-algorithms claim"},
        {"id": "panel", "phrase": "review panel participation certifies the result",
         "formal": "(no mathematical token)", "gap": true,
         "why": "authority is not a proof; the panel itself said participation is not certification"},
        {"id": "benchmark", "phrase": "benchmarks show",
         "formal": "exists finitely many runs", "gap": true,
         "why": "a finite measurement cannot reach a universal asymptotic claim"},
        {"id": "bbbv", "phrase": "BBBV lower bound",
         "formal": "forall A in the black-box model", "gap": false,
         "why": "correct but model-restricted; see reduction bbbv-to-3sat"}
    ]
}

export fn translation_gaps() {
    let rows = []
    for t in translation_table() {
        if t["gap"] { rows.push(t) }
    }
    return rows
}

export fn gap_lookup(id) {
    for t in translation_table() {
        if t["id"] == id { return t }
    }
    return {"id": id, "gap": true, "why": "unknown phrase is treated as a gap"}
}

// ---------------------------------------------------------------------------
// 7. Certificates, including false positives issued by our own modules
// ---------------------------------------------------------------------------

export fn certificates() {
    return [
        {"id": "l2-eth-equivalence", "issued_by": "bun:eth / bun:pramana at d43dec0",
         "level": 2, "self_issued": false,
         "claimed": "ETH true <=> liminf s > 0 for every correct algorithm",
         "fault": "liminf-too-strong", "gaps": [], "s_value": 0.0,
         "pramana": "anumana", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "l2-audit-proves-eth", "issued_by": "bun:pramana.audit()",
         "level": 2, "self_issued": false,
         "claimed": "CERTIFIED 10/10 proves that ETH is UNRESOLVED",
         "fault": "scope-overclaim", "gaps": [], "s_value": 0.0,
         "pramana": "pratyaksha", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "lean-verifies-theorem", "issued_by": "2026 AI vendor material",
         "level": 0, "self_issued": false,
         "claimed": "a Lean 4 file verifies the worst-case 2^o(n) theorem",
         "fault": "premise-gap", "gaps": ["lean"], "s_value": 0.0,
         "pramana": "anumana", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "journalism-settles", "issued_by": "2026 news coverage",
         "level": 0, "self_issued": false,
         "claimed": "two independent disproofs published the same day settle ETH",
         "fault": "wrong-pramana", "gaps": ["press"], "s_value": 0.0,
         "pramana": "shabda", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "panel-certified", "issued_by": "expert review panel",
         "level": 0, "self_issued": false,
         "claimed": "panel participation certifies the result",
         "fault": "authority-gap", "gaps": ["panel"], "s_value": 0.0,
         "pramana": "shabda", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "benchmark-decides", "issued_by": "a finite DPLL sweep",
         "level": 1, "self_issued": false,
         "claimed": "n = 12..32 nodes 10 -> 175 decide that ETH is true",
         "fault": "wrong-pramana", "gaps": ["benchmark"], "s_value": 0.0,
         "pramana": "pratyaksha", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "bbbv-structured", "issued_by": "naive quantum reading",
         "level": 0, "self_issued": false,
         "claimed": "BBBV Omega(sqrt N) lower-bounds structured 3SAT",
         "fault": "model-transfer", "gaps": [], "s_value": 0.5,
         "pramana": "upamana", "type": "model-bound",
         "expected": "REJECTED"},
        {"id": "grover-refutes", "issued_by": "naive quantum reading",
         "level": 0, "self_issued": false,
         "claimed": "Grover 2^(n/2) refutes ETH",
         "fault": "shape-error", "gaps": [], "s_value": 0.5,
         "pramana": "anumana", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "one-percent-refutes", "issued_by": "the vlog",
         "level": 0, "self_issued": false,
         "claimed": "2^(0.99n) is subexponential and refutes ETH",
         "fault": "shape-error", "gaps": [], "s_value": 0.99,
         "pramana": "anumana", "type": "universal-algorithm",
         "expected": "REJECTED"},
        {"id": "nyaya-self-certified", "issued_by": "bun:nyaya.audit()",
         "level": 3, "self_issued": true,
         "claimed": "nyaya's own CERTIFIED verdict proves nyaya is correct",
         "fault": "self-reference", "gaps": [], "s_value": 0.0,
         "pramana": "anumana", "type": "self-claim",
         "expected": "REJECTED"},
        {"id": "l3-correct-invariant", "issued_by": "bun:nyaya",
         "level": 3, "self_issued": true,
         "claimed": "limsup s > 0 is the correct per-algorithm ETH invariant",
         "fault": "none", "gaps": [], "s_value": 0.0,
         "pramana": "anumana", "type": "theorem-statement",
         "expected": "ACCEPTED"}
    ]
}

fn fault_reason(f) {
    if f == "liminf-too-strong" { return "De Morgan: not(liminf>0) = liminf=0, not s->0; also stronger than ETH" }
    if f == "scope-overclaim" { return "CERTIFIED 10/10 certifies ten module self-checks, not a theorem about ETH" }
    if f == "premise-gap" { return "formal derivation checks premises, not the NL<->formal bridge" }
    if f == "wrong-pramana" { return "can_settle() false: testimony/measurement cannot reach a forall-algorithms claim" }
    if f == "authority-gap" { return "authority is not a pramana for a universal theorem" }
    if f == "model-transfer" { return "BBBV is proved only in the black-box model; structured 3SAT is not an oracle" }
    if f == "shape-error" { return "s > 0: the exponent density does not tend to 0, so ETH survives" }
    if f == "self-reference" { return "a verifier cannot certify its own correctness; that is the self-challenge rule" }
    return "no fault found: quantifier prefix, assumptions and witnesses all check out"
}

export fn adjudicate_certificate(c) {
    let checks = []
    let f = c["fault"]

    if f == "liminf-too-strong" {
        let r = level2_review()
        checks.push({"check": "de-morgan", "pass": not r["complementary"],
                     "detail": "correct negation is " + r["correct_negation_prefix"]})
        checks.push({"check": "not-stronger", "pass": r["stronger_than_eth"],
                     "detail": r["why"]})
    }
    if f == "scope-overclaim" {
        let ok = not can_settle(c["pramana"], c["type"])
        checks.push({"check": "pramana-reach", "pass": ok,
                     "detail": "self-checks are pratyaksha; ETH is universal-algorithm"})
        checks.push({"check": "scope", "pass": true,
                     "detail": "10/10 is a count of module self-checks only"})
    }
    if f == "premise-gap" or f == "authority-gap" {
        var all_gap = true
        for g in c["gaps"] {
            if not gap_lookup(g)["gap"] { all_gap = false }
        }
        checks.push({"check": "translation-gap", "pass": all_gap,
                     "detail": "the phrase has no formal counterpart"})
    }
    if f == "wrong-pramana" {
        let ok = not can_settle(c["pramana"], c["type"])
        checks.push({"check": "pramana-reach", "pass": ok,
                     "detail": c["pramana"] + " cannot settle " + c["type"]})
    }
    if f == "model-transfer" {
        let q = bbbv_transfer()
        checks.push({"check": "model-restriction", "pass": not q["model_ok"],
                     "detail": q["restriction"]})
    }
    if f == "shape-error" {
        checks.push({"check": "s-positive", "pass": c["s_value"] > 0.0,
                     "detail": "s = " + num(c["s_value"]) + " > 0, so T is not 2^o(n)"})
    }
    if f == "self-reference" {
        checks.push({"check": "self-issued", "pass": c["self_issued"],
                     "detail": "issued by the verifier itself; must be rejected"})
    }
    if f == "none" {
        let fx = level3_fix_check()
        checks.push({"check": "complementary", "pass": fx["complementary"],
                     "detail": fx["claim_prefix"] + "  vs  " + fx["negation_prefix"]})
        let cr = challenge_rules()
        checks.push({"check": "witness-survival", "pass": cr["new_errors"] == 0,
                     "detail": "corrected rule matches all " + num(float(cr["witnesses"])) + " witnesses"})
    }

    var passed = 0
    for x in checks { if x["pass"] { passed = passed + 1 } }
    let accepted = f == "none" and passed == checks.len()
    let verdict = pick(accepted, "ACCEPTED", "REJECTED")
    return {"id": c["id"], "issued_by": c["issued_by"], "level": c["level"],
            "claimed": c["claimed"], "checks": checks,
            "passed": passed, "total": checks.len(),
            "verdict": verdict, "expected": c["expected"],
            "caught": verdict == c["expected"], "reason": fault_reason(f)}
}

export fn adjudicate_all_certificates() {
    let rows = []
    for c in certificates() { rows.push(adjudicate_certificate(c)) }
    return rows
}

export fn false_positive_scan() {
    let rows = []
    var total = 0
    var caught = 0
    for r in adjudicate_all_certificates() {
        if r["expected"] == "REJECTED" {
            total = total + 1
            if r["caught"] { caught = caught + 1 }
            rows.push({"id": r["id"], "issued_by": r["issued_by"],
                       "verdict": r["verdict"], "caught": r["caught"],
                       "reason": r["reason"]})
        }
    }
    return {"rows": rows, "total": total, "caught": caught,
            "all_caught": caught == total,
            "verdict": pick(caught == total, "ALL_FALSE_POSITIVES_CAUGHT", "FAILED")}
}

export fn self_challenge() {
    let checks = []
    var pramana_rejected = false
    var self_rejected = false
    var corrected_accepted = false
    for r in adjudicate_all_certificates() {
        if r["id"] == "l2-eth-equivalence" and r["verdict"] == "REJECTED" { pramana_rejected = true }
        if r["id"] == "l2-audit-proves-eth" and r["verdict"] == "REJECTED" { pramana_rejected = true }
        if r["id"] == "nyaya-self-certified" and r["verdict"] == "REJECTED" { self_rejected = true }
        if r["id"] == "l3-correct-invariant" and r["verdict"] == "ACCEPTED" { corrected_accepted = true }
    }
    checks.push({"check": "rejects-level-2-certificate", "pass": pramana_rejected,
                 "detail": "the liminf theorem and the 10/10 scope overclaim are both rejected"})
    checks.push({"check": "rejects-own-certificate", "pass": self_rejected,
                 "detail": "nyaya refuses to certify its own correctness"})
    checks.push({"check": "accepts-corrected-theorem", "pass": corrected_accepted,
                 "detail": "limsup invariant passes De Morgan and witness challenge"})
    var passed = 0
    for c in checks { if c["pass"] { passed = passed + 1 } }
    return {"checks": checks, "passed": passed, "total": checks.len(),
            "verdict": pick(passed == checks.len(), "SELF_CHALLENGE_PASSED", "FAILED")}
}

