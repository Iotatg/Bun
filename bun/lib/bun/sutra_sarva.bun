export fn review_ledger() {
    return [
        {"id": "B1", "claim": "2^3^2 -> 64, expected 512",
         "reproduced": "64", "verdict": "CONFIRMED",
         "fix": "^ right-associative in both evaluators"},
        {"id": "B2", "claim": "-3+5 crashes: pop on empty list",
         "reproduced": "pop on empty list", "verdict": "CONFIRMED",
         "fix": "unary +/- tokens; result 2"},
        {"id": "B3", "claim": "2+*3 crashes: pop on empty list",
         "reproduced": "pop on empty list", "verdict": "CONFIRMED",
         "fix": "controlled 'no left operand' error"},
        {"id": "B4", "claim": "sum 1..-5 returns 15",
         "reproduced": "SOLVED 1+2+...+5 = 15", "verdict": "CONFIRMED",
         "fix": "signed endpoint, INVALID_INPUT for n < 1"},
        {"id": "B5", "claim": "0*x+7=7 infinitely many; solver mishandles a=0",
         "reproduced": "Runtime error: division by zero", "verdict": "CONFIRMED_WITH_CORRECTION",
         "fix": "INFINITE_SOLUTIONS / NO_SOLUTION, no crash"},
        {"id": "B6", "claim": "boundary_ok has always-true checks",
         "reproduced": "ans-ans, 0*b/100, hardcoded 1*2/2-1", "verdict": "CONFIRMED",
         "fix": "falsifiable identities + certificate_probe 7/7"},
        {"id": "X1", "claim": "2x-5=9 negative coefficient parsing risk",
         "reproduced": "2x + 5 = 9 => x = 2 (correct is 7)", "verdict": "CONFIRMED_NEW_BUG",
         "fix": "signed coefficients; now x = 7"},
        {"id": "X2", "claim": "2a+3 unknown chars silently ignored",
         "reproduced": "5.0", "verdict": "CONFIRMED",
         "fix": "unknown character rejected"},
        {"id": "X3", "claim": "2(3+4) implicit multiplication unsupported",
         "reproduced": "2.0", "verdict": "CONFIRMED",
         "fix": "implicit * inserted; result 14"},
        {"id": "X4", "claim": "2*(3+4 unmatched parenthesis",
         "reproduced": "pop on empty list", "verdict": "CONFIRMED",
         "fix": "unmatched opening parenthesis error"},
        {"id": "X5", "claim": "2..3 invalid numeric token",
         "reproduced": "cannot convert to float", "verdict": "CONFIRMED",
         "fix": "invalid number: multiple decimal points"}
    ]
}

// The five verification levels proposed by the review, with HONEST status.
// SUTRA currently reaches level 2 on the elementary kinds and NOTHING above.
export fn verification_levels() {
    return [
        {"level": 1, "name": "COMPUTED", "status": "IMPLEMENTED",
         "meaning": "numerical answer calculated"},
        {"level": 2, "name": "INDEPENDENTLY_CHECKED", "status": "IMPLEMENTED",
         "meaning": "a second, different algorithm verifies the result"},
        {"level": 3, "name": "SYMBOLICALLY_VERIFIED", "status": "NOT_IMPLEMENTED",
         "meaning": "algebraic transformations and identities checked"},
        {"level": 4, "name": "FORMALLY_VERIFIED", "status": "NOT_IMPLEMENTED",
         "meaning": "Lean kernel accepted a proof"},
        {"level": 5, "name": "RESEARCH_REVIEWED", "status": "NOT_IMPLEMENTED",
         "meaning": "original claim + formalization independently reviewed"}
    ]
}

// Accepted as DIRECTION, not delivered. A written phase is not a built phase.
export fn roadmap() {
    return [
        {"phase": 0, "name": "correctness audit + parser/certificate fix", "status": "DONE",
         "evidence": "this commit; 7/7 wrong answers rejected"},
        {"phase": 1, "name": "AST, exact rationals, domain system", "status": "NOT_IMPLEMENTED"},
        {"phase": 2, "name": "symbolic algebra / calculus / linear algebra", "status": "NOT_IMPLEMENTED"},
        {"phase": 3, "name": "advanced mathematics engines", "status": "NOT_IMPLEMENTED"},
        {"phase": 4, "name": "universal science engines", "status": "NOT_IMPLEMENTED"},
        {"phase": 5, "name": "Lean 4 + Mathlib proof bridge", "status": "NOT_IMPLEMENTED"},
        {"phase": 6, "name": "research intelligence / theorem graph", "status": "NOT_IMPLEMENTED"},
        {"phase": 7, "name": "universal reasoning router", "status": "NOT_IMPLEMENTED"},
        {"phase": 8, "name": "performance, reliability, self-testing", "status": "NOT_IMPLEMENTED"},
        {"phase": 9, "name": "public release and ecosystem", "status": "NOT_IMPLEMENTED"}
    ]
}

export fn audit() {
    var checks = []
    checks.push({"check": "recipe-has-5-steps", "pass": alphabet().len() == 5})
    checks.push({"check": "shapes-are-5", "pass": shapes().len() == 5})
    checks.push({"check": "moves-are-7", "pass": seven_moves().len() == 7})
    checks.push({"check": "checks-are-4", "pass": four_checks().len() == 4})
    checks.push({"check": "calc-2+3", "pass": f_abs(calc("2+3")["value"] - 5.0) < 1e-9})
    checks.push({"check": "calc-precedence", "pass": f_abs(calc("(2+3)*4^2")["value"] - 80.0) < 1e-9})
    checks.push({"check": "percent-50-of-80", "pass": f_abs(solve({"kind": "percent", "a": 50.0, "b": 80.0})["answer"] - 40.0) < 1e-9})
    checks.push({"check": "linear-3x+7=22", "pass": f_abs(solve({"kind": "linear", "a": 3.0, "b": 7.0, "c": 22.0})["answer"] - 5.0) < 1e-9})
    checks.push({"check": "sum-1..100", "pass": f_abs(solve({"kind": "sum", "n": 100.0})["answer"] - 5050.0) < 1e-9})
    checks.push({"check": "ratio-7/8<11/12", "pass": solve({"kind": "ratio", "a": 7.0, "b": 8.0, "c": 11.0, "d": 12.0})["answer"] < 0.0})
    checks.push({"check": "certificate-4-of-4", "pass": solve({"kind": "sum", "n": 10.0})["certificate"]["passed"] == 4})
    checks.push({"check": "theorem-out-of-scope", "pass": ask("Prove the quasi-Riemann hypothesis")["status"] == "OUT_OF_SCOPE_FOR_SUTRA"})
    checks.push({"check": "course-has-10", "pass": course().len() == 10})
    checks.push({"check": "course-9-solved-1-out-of-scope", "pass": course()[9]["q"]["kind"] == "theorem"})
    checks.push({"check": "steps-are-5", "pass": steps(course()[0]["q"]).len() == 5})
    checks.push({"check": "measurement-notes-present", "pass": measurement_notes().len() >= 4})
    checks.push({"check": "eth-not-claimed-solved", "pass": verdict()["research_theorems_solved_by_sutra"] == 0})
    // --- regression checks for the external review -----------------------
    checks.push({"check": "calc-right-assoc", "pass": f_abs(calc("2^3^2")["value"] - 512.0) < 1e-9})
    checks.push({"check": "calc-unary-minus", "pass": f_abs(calc("-3+5")["value"] - 2.0) < 1e-9})
    checks.push({"check": "calc-unary-vs-power", "pass": f_abs(calc("-3^2")["value"] + 9.0) < 1e-9})
    checks.push({"check": "calc-implicit-mult", "pass": f_abs(calc("2(3+4)")["value"] - 14.0) < 1e-9})
    checks.push({"check": "calc-controlled-error", "pass": not calc("2+*3")["ok"]})
    checks.push({"check": "two-oracles-agree", "pass": f_abs(calc("(2+3)*4^2")["value"] - calc_alt("(2+3)*4^2")["value"]) < 1e-9})
    checks.push({"check": "sum-negative-rejected", "pass": ask("sum 1..-5")["status"] == "INVALID_INPUT"})
    checks.push({"check": "linear-zero-infinite", "pass": ask("0*x + 7 = 7")["status"] == "INFINITE_SOLUTIONS"})
    checks.push({"check": "linear-zero-none", "pass": ask("0*x + 7 = 10")["status"] == "NO_SOLUTION"})
    checks.push({"check": "linear-negative-coeff", "pass": has(ask("2x-5=9")["answer_text"], "x = 7")})
    checks.push({"check": "certificate-probe-7-of-7", "pass": certificate_probe()["caught"] == certificate_probe()["total"]})
    checks.push({"check": "no-vacuous-check", "pass": check_answer({"kind": "calc", "expr": "2+3"}, 999.0)["verdict"] == "REJECTED"})
    checks.push({"check": "verification-level-honest", "pass": solve({"kind": "sum", "n": 10.0})["verification_level"] == "INDEPENDENTLY_CHECKED"})
    checks.push({"check": "proof-status-not-established", "pass": solve({"kind": "sum", "n": 10.0})["proof_status"] == "NOT_ESTABLISHED"})
    checks.push({"check": "roadmap-mostly-unbuilt", "pass": roadmap()[1]["status"] == "NOT_IMPLEMENTED"})
    checks.push({"check": "levels-honest", "pass": verification_levels()[4]["status"] == "NOT_IMPLEMENTED"})
    checks.push({"check": "review-ledger-recorded", "pass": review_ledger().len() == 11})
    var passed = 0
    for c in checks { if c["pass"] { passed = passed + 1 } }
    return {"checks": checks, "passed": passed, "total": checks.len(),
            "verdict": pick(passed == checks.len(), "CERTIFIED", "FAILED"),
            "scope": "module self-checks only — NOT a proof of any theorem; external pytest is separate evidence"}
}
