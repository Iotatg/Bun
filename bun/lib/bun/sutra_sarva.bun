// bun:sutra_sarva — SUTRA Level 4: "ek hi raasta, har sawaal".
//
//   Level 1  bun:sutra        kya aakaar hai?                  shape
//   Level 2  bun:pramana      kaun-sa pramaan tay karega?      evidence
//   Level 3  bun:nyaya        kya mera nishkarsh sahi hai?     self-challenge
//   Level 4  bun:sutra_sarva  har sawaal ke liye EK hi aasan   method + map
//                              tarika, aur poore corpus ka     honest naksha
//
// Origin: the request to "solve ALL of openai/math with SUTRA, in the easiest
// possible way". The honest answer is in verdict(): SUTRA does NOT prove
// 373 research theorems. What it CAN do, and does here, is
//
//   (a) give ONE five-step recipe that a child can apply to any question,
//   (b) actually SOLVE a well-defined class of questions with exact answers
//       and four independent checks,
//   (c) process EVERY ONE of the 373 result families of the real catalogue
//       into a shape/move/status card, measured from the clone,
//   (d) verify the SHAPE of the ETH runtime bound from the repo's own Lean
//       source, and say plainly what that does and does not establish.
//
// "SUTRA is a filter, not a solver" (README, Level 1) still holds for research
// mathematics. This module adds a real solver for the ELEMENTARY layer and an
// honest, machine-generated map for the rest. No theorem is claimed solved.

import { num, fmt, has_key, moves } from "bun:sutra"

let M = ffi_load("math")
let f_log = M["log"]
let f_sqrt = M["sqrt"]
let f_abs = M["fabs"]

fn pick(c, a, b) {
    if c { return a }
    return b
}

fn has(hay, needle) {
    return index_of(hay, needle) >= 0
}

fn count_of(hay, needle) {
    return regex_findall(needle, hay).len()
}

// ---------------------------------------------------------------------------
// 1. S-U-T-R-A : the one easy recipe
//
// The five letters of SUTRA ARE the five steps. Nothing else to memorise.
// ---------------------------------------------------------------------------

