        {"id": "shape", "hindi": "आकार", "asks": "kya jawaab ka aakaar sawaal ke aakaar se milta hai?"},
        {"id": "number", "hindi": "संख्या", "asks": "kya alag raaste se wahi sankhya aati hai?"},
        {"id": "dimension", "hindi": "मात्रा", "asks": "kya unit / token / maatra sahi hai?"},
