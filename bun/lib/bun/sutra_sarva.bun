// ---------------------------------------------------------------------------
// 2. S — strip the vocabulary
// ---------------------------------------------------------------------------

fn digit_char(ch) {
    return index_of("0123456789", ch) >= 0
}

fn op_char(ch) {
    return index_of("+-*/^()", ch) >= 0
}

export fn strip(text) {
    // No capturing groups: re.findall returns only the group when one exists.
    let nums_raw = regex_findall("[0-9]+\\.[0-9]+|[0-9]+", text)
    let fracs = regex_findall("[0-9]+/[0-9]+", text)
    var nums = []
    for s in nums_raw { nums.push(float(s)) }
    var ops = []
    var i = 0
    while i < text.len() {
        let ch = text[i]
        if op_char(ch) { ops.push(ch) }
        i = i + 1
    }
    let low = lower(text)
    var quantifier = false
    if has(low, "for all") or has(low, "forall") or has(low, "exists") or has(low, "every") {
        quantifier = true
    }
    var proof_word = false
    if has(low, "prove") or has(low, "theorem") or has(low, "conjecture") or has(low, "show that") {
        proof_word = true
    }
    return {"numbers": nums, "number_count": nums.len(),
            "fractions": fracs.len(), "operators": ops,
            "operator_count": ops.len(), "quantifier": quantifier,
            "proof_word": proof_word,
            "skeleton": "given:" + str(nums.len()) + " numbers, goal:" + pick(proof_word, "PROVE", "COMPUTE")}
}

// ---------------------------------------------------------------------------
// 3. U — uncover the shape (keyword evidence, not a guess)
// ---------------------------------------------------------------------------

export fn shape_of(text) {
    let t = lower(text)
    if has(t, "logarith") or has(t, "log n") or has(t, "log(") or has(t, "log log") or has(t, "binary search") {
        return {"shape": "logarithmic", "why": "log / repeated halving",
                "evidence": "logarithmic keyword"}
    }
    if has(t, "exponential") or has(t, "subexponential") or has(t, "2^") or has(t, "doubl") or has(t, "exp(") or has(t, "growth") {
        return {"shape": "exponential", "why": "fixed-ratio growth",
                "evidence": "exponential keyword"}
    }
    if has(t, "polynomial") or has(t, "quadratic") or has(t, "cubic") or has(t, "power law") or has(t, "degree") or has(t, "^2") or has(t, "square") {
        return {"shape": "power", "why": "scale invariance f(Lx)/f(x)=L^k",
                "evidence": "power keyword"}
    }
    if has(t, "constant") or has(t, "bounded") or has(t, "o(1)") or has(t, "uniform bound") or has(t, "fixed") {
        return {"shape": "constant", "why": "does not change with n",
                "evidence": "constant keyword"}
    }
    return {"shape": "structural", "why": "sawaal ka aakaar nahi, banavat hai",
            "evidence": "no growth keyword — theorem / definition / classification"}
}

// ---------------------------------------------------------------------------
// 4. T — choose the move
// ---------------------------------------------------------------------------

export fn choose_move(shape, kind) {
    if kind == "theorem" { return 7 }
    if kind == "ratio" { return 3 }
    if kind == "growth" { return 5 }
    if shape == "logarithmic" { return 6 }
    if shape == "exponential" { return 5 }
    if shape == "constant" { return 4 }
    return 2
}

// ---------------------------------------------------------------------------
// 5. Arithmetic — TWO INDEPENDENT algorithms, not one.
//    calc()     : shunting-yard (explicit value/operator stacks)
//    calc_alt() : recursive descent (call stack + precedence grammar)
//    The certificate compares them. Agreement is evidence, never proof.
//
//    Correctness fixes (external code review, verified by reproduction):
//      * ^ is RIGHT-associative: 2^3^2 = 2^(3^2) = 512, not 64
//      * unary +/- supported: -3+5 = 2, 2^-3 = 0.125, -3^2 = -9
//      * implicit multiplication: 2(3+4) = 14
//      * unknown chars, malformed numbers, unmatched parens, missing operands
//        and division by zero return a CONTROLLED error dict, never a crash
//        and never a silently wrong number.
// ---------------------------------------------------------------------------

fn precedence(op) {
    if op == "+" { return 1 }
    if op == "-" { return 1 }
    if op == "*" { return 2 }
    if op == "/" { return 2 }
    if op == "u-" { return 3 }
    if op == "u+" { return 3 }
    if op == "^" { return 4 }
    return 0
}

fn is_unary(op) {
    return op == "u-" or op == "u+"
}

fn should_reduce(top_op, op) {
    let tp = precedence(top_op)
    let p = precedence(op)
    // Right-associative ^ keeps an equal-precedence ^ on the stack.
    if op == "^" { return tp > p }
    return tp >= p
}

fn apply_op(a, b, op) {
    if op == "+" { return a + b }
    if op == "-" { return a - b }
    if op == "*" { return a * b }
    if op == "/" { return a / b }
    if op == "^" { return a ** b }
    if op == "u-" { return -a }
    if op == "u+" { return a }
    return 0.0
}

fn err_toks(msg) {
    return {"ok": false, "toks": [], "error": msg, "count": 0}
}

// Strict tokenizer. Every rejected input gets a reason; nothing is skipped.
export fn tokenize(expr) {
    var toks = []
    var i = 0
    var expect_operand = true
    var depth = 0
    while i < expr.len() {
        let ch = expr[i]
        if ch == " " { i = i + 1 continue }
        if digit_char(ch) or ch == "." {
            var s = ""
            var dots = 0
            while i < expr.len() {
                let c = expr[i]
                if digit_char(c) or c == "." {
                    if c == "." { dots = dots + 1 }
                    s = s + c
                    i = i + 1
                    continue
                }
                break
            }
            if dots > 1 { return err_toks("invalid number: multiple decimal points") }
            if s == "." { return err_toks("invalid number: bare decimal point") }
            if not expect_operand { return err_toks("missing operator before number") }
            toks.push(["n", float(s)])
            expect_operand = false
            continue
        }
        if ch == "(" {
            // A number or ')' immediately before '(' means multiplication.
            if not expect_operand { toks.push(["o", "*"]) }
            toks.push(["o", "("])
            depth = depth + 1
            expect_operand = true
            i = i + 1
            continue
        }
        if ch == ")" {
            if expect_operand { return err_toks("empty parentheses or trailing operator") }
            if depth == 0 { return err_toks("unmatched closing parenthesis") }
            toks.push(["o", ")"])
            depth = depth - 1
            expect_operand = false
            i = i + 1
            continue
        }
        if ch == "+" or ch == "-" {
            if expect_operand {
                toks.push(["o", "u" + ch])
            } else {
                toks.push(["o", ch])
                expect_operand = true
            }
            i = i + 1
            continue
        }
        if ch == "*" or ch == "/" or ch == "^" {
            if expect_operand { return err_toks("operator '" + ch + "' has no left operand") }
            toks.push(["o", ch])
            expect_operand = true
            i = i + 1
            continue
        }
        return err_toks("unknown character '" + ch + "'")
    }
    if expect_operand { return err_toks("expression ends with an operator") }
    if depth != 0 { return err_toks("unmatched opening parenthesis") }
    return {"ok": true, "toks": toks, "error": "", "count": toks.len()}
}

fn reduce_one(vals, ops) {
    let o = ops.pop()
    if vals.len() < 1 { return "stack underflow" }
    if is_unary(o) {
        let a = vals.pop()
        vals.push(apply_op(a, 0.0, o))
        return ""
    }
    if vals.len() < 2 { return "stack underflow" }
    let b = vals.pop()
    let a = vals.pop()
    if o == "/" and f_abs(b) < 1e-15 { return "division by zero" }
    vals.push(apply_op(a, b, o))
    return ""
}

fn calc_error(expr, msg, count) {
    return {"ok": false, "value": 0.0, "error": msg,
            "tokens": count, "expr": expr, "kind": "calc",
            "method": "shunting-yard"}
}

export fn calc(expr) {
    let t = tokenize(expr)
    if not t["ok"] { return calc_error(expr, t["error"], 0) }
    let toks = t["toks"]
    var vals = []
    var ops = []
    var i = 0
    while i < toks.len() {
        let tk = toks[i]
        if tk[0] == "n" { vals.push(tk[1]) }
        if tk[0] == "o" {
            let op = tk[1]
            if op == "(" { ops.push(op) }
            if op == ")" {
                while ops.len() > 0 and ops[ops.len() - 1] != "(" {
                    let e = reduce_one(vals, ops)
                    if e != "" { return calc_error(expr, e, t["count"]) }
                }
                if ops.len() > 0 { ops.pop() }
            }
            if op != "(" and op != ")" {
                if is_unary(op) {
                    // A unary operator appears in operand position: never
                    // reduce the operator that is waiting for its right side.
                    ops.push(op)
                } else {
                    while ops.len() > 0 and ops[ops.len() - 1] != "(" and should_reduce(ops[ops.len() - 1], op) {
                        let e = reduce_one(vals, ops)
                        if e != "" { return calc_error(expr, e, t["count"]) }
                    }
                    ops.push(op)
                }
            }
        }
        i = i + 1
    }
    while ops.len() > 0 {
        if ops[ops.len() - 1] == "(" { return calc_error(expr, "unmatched opening parenthesis", t["count"]) }
        let e = reduce_one(vals, ops)
        if e != "" { return calc_error(expr, e, t["count"]) }
    }
    if vals.len() != 1 { return calc_error(expr, "unconsumed operands", t["count"]) }
    return {"ok": true, "value": vals[0], "error": "",
            "tokens": t["count"], "expr": expr, "kind": "calc",
            "method": "shunting-yard"}
}

// ---- independent oracle: recursive descent -------------------------------

fn alt_peek(st) {
    if st["i"] >= st["toks"].len() { return ["e", ""] }
    return st["toks"][st["i"]]
}

fn alt_expr(st) {
    var v = alt_term(st)
    while 1 == 1 {
        let p = alt_peek(st)
        if p[0] != "o" { break }
        if p[1] != "+" and p[1] != "-" { break }
        st["i"] = st["i"] + 1
        let w = alt_term(st)
        if p[1] == "+" { v = v + w } else { v = v - w }
    }
    return v
}

fn alt_term(st) {
    var v = alt_unary(st)
    while 1 == 1 {
        let p = alt_peek(st)
        if p[0] != "o" { break }
        if p[1] != "*" and p[1] != "/" { break }
        st["i"] = st["i"] + 1
        let w = alt_unary(st)
        if p[1] == "*" {
            v = v * w
        } else {
            if f_abs(w) < 1e-15 { st["err"] = "division by zero" return 0.0 }
            v = v / w
        }
    }
    return v
}

fn alt_unary(st) {
    let p = alt_peek(st)
    if p[0] == "o" and (p[1] == "u-" or p[1] == "u+") {
        st["i"] = st["i"] + 1
        let v = alt_unary(st)
        if p[1] == "u-" { return -v }
        return v
    }
    return alt_power(st)
}

fn alt_power(st) {
    let v = alt_primary(st)
    let p = alt_peek(st)
    if p[0] == "o" and p[1] == "^" {
        st["i"] = st["i"] + 1
        // Exponent calls alt_unary, so 2^3^2 groups from the RIGHT.
        let e = alt_unary(st)
        return v ** e
    }
    return v
}

fn alt_primary(st) {
    let p = alt_peek(st)
    if p[0] == "n" { st["i"] = st["i"] + 1 return p[1] }
    if p[0] == "o" and p[1] == "(" {
        st["i"] = st["i"] + 1
        let v = alt_expr(st)
        let q = alt_peek(st)
        if q[0] == "o" and q[1] == ")" {
            st["i"] = st["i"] + 1
        } else {
            st["err"] = "unmatched opening parenthesis"
        }
        return v
    }
    st["err"] = "expected a number or parenthesised expression"
    return 0.0
}

export fn calc_alt(expr) {
    let t = tokenize(expr)
    if not t["ok"] {
        return {"ok": false, "value": 0.0, "error": t["error"],
                "tokens": 0, "expr": expr, "method": "recursive-descent"}
    }
    let st = {"i": 0, "toks": t["toks"], "err": ""}
    let v = alt_expr(st)
    if st["err"] != "" {
        return {"ok": false, "value": 0.0, "error": st["err"],
                "tokens": t["count"], "expr": expr, "method": "recursive-descent"}
    }
    if st["i"] != t["count"] {
        return {"ok": false, "value": 0.0, "error": "unconsumed tokens",
                "tokens": t["count"], "expr": expr, "method": "recursive-descent"}
    }
    return {"ok": true, "value": v, "error": "",
            "tokens": t["count"], "expr": expr, "method": "recursive-descent"}
}

// ---------------------------------------------------------------------------
// 6. The elementary solver — exact answers for a DEFINED class of questions
// ---------------------------------------------------------------------------

fn expected_shape(kind) {
    if kind == "percent" { return "constant" }
    if kind == "linear" { return "power" }
    if kind == "sum" { return "power" }
    if kind == "ratio" { return "constant" }
    if kind == "growth" { return "exponential" }
    if kind == "unit" { return "constant" }
    return "constant"
}

// An INDEPENDENT route to the shape: feed a descriptive phrase through
// shape_of() (keyword evidence) instead of trusting expected_shape() directly.
fn shape_word(kind) {
    if kind == "percent" { return "constant bounded" }
    if kind == "linear" { return "polynomial degree" }
    if kind == "sum" { return "polynomial quadratic" }
    if kind == "ratio" { return "constant fixed" }
    if kind == "growth" { return "exponential growth" }
    if kind == "unit" { return "constant fixed" }
    return "constant bounded"
}

// ---------------------------------------------------------------------------
// 6b. Certificate, redesigned after external code review.
//
// The old boundary_ok() had three branches that were ALWAYS true:
//   calc    : f_abs(ans - ans) < 1e-9
//   percent : f_abs(0.0 * b / 100.0) < 1e-9
//   sum     : f_abs(1*2/2 - 1) < 1e-9       (hardcoded, ignores the input)
// Those could never reject anything. Now every check has an explicit METHOD,
// a flag saying whether it can detect a wrong numeric answer, and a route
// that does NOT reuse the solver's own formula. See certificate_probe().
// ---------------------------------------------------------------------------

fn recompute(q, ans) {
    let kind = q["kind"]
    if kind == "calc" {
        let a = calc_alt(q["expr"])
        if not a["ok"] { return 0.0 }
        return a["value"]
    }
    if kind == "percent" { return (q["b"] / 100.0) * q["a"] }
    if kind == "linear" { return q["a"] * ans + q["b"] }
    if kind == "sum" {
        var s = 0.0
        for k in range(1, int(q["n"]) + 1) { s = s + float(k) }
        return s
    }
    if kind == "ratio" { return float(q["a"] * q["d"] - q["c"] * q["b"]) }
    if kind == "unit" { return q["a"] * q["factor"] }
    if kind == "growth" { return float(q["exponent"]) }
    return ans
}

fn recompute_method(kind) {
    if kind == "calc" { return "recursive-descent evaluator, independent of shunting-yard" }
    if kind == "percent" { return "(b/100)*a, different association from solver" }
    if kind == "linear" { return "substitute x back into a*x+b" }
    if kind == "sum" { return "explicit loop 1..n, independent of n(n+1)/2" }
    if kind == "ratio" { return "cross multiplication a*d - c*b" }
    if kind == "unit" { return "a * factor" }
    if kind == "growth" { return "exponent scalar" }
    return "no independent route"
}

fn domain_ok(q, ans) {
    let kind = q["kind"]
    if kind == "calc" {
        let c = calc(q["expr"])
        return c["ok"] and c["tokens"] > 0
    }
    if kind == "ratio" { return f_abs(q["b"]) > 1e-15 and f_abs(q["d"]) > 1e-15 }
    if kind == "sum" { return q["n"] >= 1.0 }
    if kind == "linear" { return f_abs(q["a"]) > 1e-12 }
    if kind == "percent" { return q["b"] >= 0.0 }
    if kind == "unit" { return f_abs(q["factor"]) > 1e-15 }
    return true
}

// An identity that a WRONG answer must violate. No always-true branches.
fn boundary_ok(q, ans) {
    let kind = q["kind"]
    if kind == "percent" {
        let comp = (100.0 - q["a"]) * q["b"] / 100.0
        return f_abs(ans + comp - q["b"]) < 1e-9
    }
    if kind == "linear" {
        return f_abs(q["a"] * (ans + 1.0) + q["b"] - q["c"] - q["a"]) < 1e-9
    }
    if kind == "sum" {
        var s = 0.0
        for k in range(1, int(q["n"])) { s = s + float(k) }
        return f_abs(ans - (s + q["n"])) < 1e-9
    }
    if kind == "calc" {
        let m = calc("2*(" + q["expr"] + ")")
        if not m["ok"] { return false }
        return f_abs(m["value"] - 2.0 * ans) < 1e-9
    }
    if kind == "ratio" {
        if f_abs(q["b"]) < 1e-15 or f_abs(q["d"]) < 1e-15 { return false }
        let diff = q["a"] / q["b"] - q["c"] / q["d"]
        if f_abs(ans) < 1e-12 { return f_abs(diff) < 1e-9 }
        if ans > 0.0 { return diff > 0.0 }
        return diff < 0.0
    }
    if kind == "unit" { return f_abs(ans / q["factor"] - q["a"]) < 1e-9 }
    if kind == "growth" { return f_abs(ans - float(q["exponent"])) < 1e-9 }
    return false
}

fn boundary_method(kind) {
    if kind == "percent" { return "complement identity: a%b + (100-a)%b = b" }
    if kind == "linear" { return "shift invariant: a*(x+1)+b-c = a" }
    if kind == "sum" { return "loop recurrence: f(n) = f(n-1) + n" }
    if kind == "calc" { return "metamorphic relation: 2*(expr) = 2*ans" }
    if kind == "ratio" { return "independent decimal-division sign agreement" }
    if kind == "unit" { return "inverse: ans/factor = a" }
    if kind == "growth" { return "scalar identity (duplicates number check; see level)" }
    return "none"
}

// How many DISTINCT independent numeric oracles this kind really has.
// growth is a scalar passthrough: honestly 1, not 2.
fn distinct_oracles(kind) {
    if kind == "growth" { return 1 }
    return 2
}

fn no_certificate(reason) {
    return {"checks": [], "passed": 0, "total": 4,
            "verdict": "NOT_APPLICABLE",
            "scope": "no certificate issued: " + reason,
            "verification_level": "NONE",
            "proof_status": "NOT_ESTABLISHED",
            "independent_oracles": 0}
}

export fn check_answer(q, ans) {
    var checks = []
    let sh = expected_shape(q["kind"])
    let independent = shape_of(shape_word(q["kind"]))["shape"]
    checks.push({"check": "shape", "pass": sh == independent,
                 "method": "expected_shape table vs independent keyword-shape route",
                 "detects_wrong_answer": false,
                 "detail": "expected " + sh + ", keyword route says " + independent})
    let r = recompute(q, ans)
    var number_ok = false
    if q["kind"] == "linear" { number_ok = f_abs(r - q["c"]) < 1e-9 }
    if q["kind"] != "linear" { number_ok = f_abs(r - ans) < 1e-9 }
    checks.push({"check": "number", "pass": number_ok,
                 "method": recompute_method(q["kind"]),
                 "detects_wrong_answer": true,
                 "detail": "independent recompute = " + num(r)})
    let dim = domain_ok(q, ans)
    checks.push({"check": "dimension", "pass": dim,
                 "method": "operand domain validation + fully parsed expression",
                 "detects_wrong_answer": false,
                 "detail": "inputs in domain, tokens consumed"})
    let bnd = boundary_ok(q, ans)
    checks.push({"check": "boundary", "pass": bnd,
                 "method": boundary_method(q["kind"]),
                 "detects_wrong_answer": true,
                 "detail": "identity that a wrong answer must break"})
    var passed = 0
    var numeric = 0
    for c in checks {
        if c["pass"] { passed = passed + 1 }
        if c["pass"] and c["detects_wrong_answer"] { numeric = numeric + 1 }
    }
    let certified = passed == 4
    // Two checks can pass, but if they are the SAME identity (growth is a
    // scalar passthrough) there is still only one distinct oracle. Cap it.
    let cap = distinct_oracles(q["kind"])
    var effective = numeric
    if effective > cap { effective = cap }
    var level = "COMPUTED_UNVERIFIED"
    if certified and effective >= 2 { level = "INDEPENDENTLY_CHECKED" }
    if certified and effective < 2 { level = "COMPUTED" }
    return {"checks": checks, "passed": passed, "total": 4,
            "verdict": pick(certified, "CERTIFIED", "REJECTED"),
            "scope": "4 checks, " + str(numeric) + " can detect a wrong numeric answer (" + str(effective) + " distinct oracles); computation, NOT A PROOF of any theorem",
            "verification_level": level,
            "proof_status": "NOT_ESTABLISHED",
            "independent_oracles": effective}
}

// The real test of a certificate: inject WRONG answers and see if it rejects.
export fn certificate_probe() {
    let cases = [
        {"name": "sum-wrong", "q": {"kind": "sum", "n": 10.0}, "bad": 999.0},
        {"name": "percent-wrong", "q": {"kind": "percent", "a": 50.0, "b": 80.0}, "bad": 999.0},
        {"name": "linear-wrong", "q": {"kind": "linear", "a": 3.0, "b": 7.0, "c": 22.0}, "bad": 999.0},
        {"name": "calc-wrong", "q": {"kind": "calc", "expr": "2+3"}, "bad": 999.0},
        {"name": "ratio-wrong", "q": {"kind": "ratio", "a": 7.0, "b": 8.0, "c": 11.0, "d": 12.0}, "bad": 999.0},
        {"name": "unit-wrong", "q": {"kind": "unit", "a": 3.0, "factor": 1000.0, "from": "km", "to": "m", "unit": "m"}, "bad": 999.0},
        {"name": "growth-wrong", "q": {"kind": "growth", "exponent": 1}, "bad": 999.0}
    ]
    var rows = []
    var caught = 0
    for c in cases {
        let r = check_answer(c["q"], c["bad"])
        let rejected = r["verdict"] == "REJECTED"
        if rejected { caught = caught + 1 }
        rows.push({"case": c["name"], "rejected": rejected, "passed": r["passed"]})
    }
    return {"cases": rows, "caught": caught, "total": cases.len(),
            "verdict": pick(caught == cases.len(), "ALL_WRONG_ANSWERS_REJECTED", "FALSE_POSITIVE_RISK"),
            "note": "a certificate that cannot reject a wrong answer is vacuous"} 
}

fn special_result(kind, status, text, reason) {
    return {"kind": kind, "status": status, "answer": 0.0,
            "answer_text": text, "reason": reason,
            "shape": expected_shape(kind),
            "move": choose_move(expected_shape(kind), kind),
            "certificate": no_certificate(reason),
            "verification_level": "NONE",
            "proof_status": "NOT_ESTABLISHED"}
}

fn signed_term(x) {
    if x < 0.0 { return "- " + num(-x) }
    return "+ " + num(x)
}

export fn solve(q) {
    let kind = q["kind"]
    if kind == "theorem" {
        return {"kind": "theorem", "status": "OUT_OF_SCOPE_FOR_SUTRA",
                "answer": "UNSOLVED_BY_SUTRA", "answer_text": "SUTRA is a filter, not a proof engine",
                "shape": "structural", "move": 7,
                "reason": "ek research theorem ko pramaan chahiye (Lean / mathlib / independent review); shape aur move batana pramaan nahi hai",
                "sutra_can_do": "shape + move + 4 checks + verification map",
                "certificate": {"verdict": "NOT_APPLICABLE", "scope": "no certificate issued"},
                "verification_level": "NONE",
                "proof_status": "NOT_ESTABLISHED"}
    }
    // Reject bad inputs BEFORE computing anything. No crash, no silent guess.
    if kind == "calc" {
        let c = calc(q["expr"])
        if not c["ok"] {
            return special_result(kind, "INVALID_EXPRESSION", c["error"],
                                  "parser rejected the expression: " + c["error"])
        }
    }
    if kind == "sum" {
        if q["n"] < 1.0 {
            return special_result(kind, "INVALID_INPUT", "sum needs an integer n >= 1",
                                  "upper limit out of domain (negative or zero)")
        }
        if f_abs(q["n"] - float(int(q["n"]))) > 1e-9 {
            return special_result(kind, "INVALID_INPUT", "sum needs an integer n >= 1",
                                  "upper limit is not an integer")
        }
    }
    if kind == "linear" {
        if f_abs(q["a"]) < 1e-12 {
            let eq = num(q["a"]) + "x " + signed_term(q["b"]) + " = " + num(q["c"])
            if f_abs(q["b"] - q["c"]) < 1e-9 {
                return special_result(kind, "INFINITE_SOLUTIONS",
                    eq + "  =>  har x ke liye sach (infinitely many solutions)",
                    "a = 0 and b = c: identity, no unique solution")
            }
            return special_result(kind, "NO_SOLUTION",
                eq + "  =>  koi x nahi",
                "a = 0 and b != c: inconsistent equation")
        }
    }
    var ans = 0.0
    var text = ""
    if kind == "calc" {
        ans = calc(q["expr"])["value"]
        text = num(ans)
    }
    if kind == "percent" {
        ans = q["a"] * q["b"] / 100.0
        text = num(q["a"]) + "% of " + num(q["b"]) + " = " + num(ans)
    }
    if kind == "linear" {
        ans = (q["c"] - q["b"]) / q["a"]
        text = num(q["a"]) + "x " + signed_term(q["b"]) + " = " + num(q["c"]) + "  =>  x = " + num(ans)
    }
    if kind == "sum" {
        ans = q["n"] * (q["n"] + 1.0) / 2.0
        text = "1+2+...+" + num(q["n"]) + " = " + num(ans)
    }
    if kind == "ratio" {
        let ad = q["a"] * q["d"]
        let cb = q["c"] * q["b"]
        ans = float(ad - cb)
        var sign = "="
        if ad > cb { sign = ">" }
        if ad < cb { sign = "<" }
        text = num(q["a"]) + "/" + num(q["b"]) + " " + sign + " " + num(q["c"]) + "/" + num(q["d"])
    }
    if kind == "growth" {
        ans = float(q["exponent"])
        text = "growth exponent " + num(ans)
    }
    if kind == "unit" {
        ans = q["a"] * q["factor"]
        text = num(q["a"]) + " " + q["from"] + " = " + num(ans) + " " + q["to"]
    }
    let cert = check_answer(q, ans)
    return {"kind": kind, "status": pick(cert["verdict"] == "CERTIFIED", "SOLVED", "REJECTED"),
            "answer": ans, "answer_text": text,
            "shape": expected_shape(kind), "move": choose_move(expected_shape(kind), kind),
            "certificate": cert,
            "verification_level": cert["verification_level"],
            "proof_status": "NOT_ESTABLISHED"}
}

// ---------------------------------------------------------------------------
// 7. ask(text) — ONE line in, solved. The "easy way" in practice.
// ---------------------------------------------------------------------------

fn numeric_only(text) {
    var i = 0
    while i < text.len() {
        let ch = text[i]
        if digit_char(ch) or op_char(ch) or ch == " " or ch == "." { i = i + 1 continue }
        return false
    }
    return true
}

export fn parse_question(text) {
    let low = lower(text)
    let nums = regex_findall("[0-9]+\\.[0-9]+|[0-9]+", text)
    var vals = []
    for s in nums { vals.push(float(s)) }
    if has(low, "%") and has(low, "of") and vals.len() >= 2 {
        return {"kind": "percent", "a": vals[0], "b": vals[1]}
    }
    // Signed pattern: the old unsigned pattern dropped the minus in
    // "sum 1..-5" and in "2x-5=9", producing a confidently wrong answer.
    let signed_pat = "-?[0-9]+\\.[0-9]+|-?[0-9]+"
    if has(low, "sum") {
        let signed = regex_findall(signed_pat, text)
        if signed.len() >= 1 {
            return {"kind": "sum", "n": float(signed[signed.len() - 1])}
        }
    }
    if has(low, " vs ") and vals.len() >= 4 {
        return {"kind": "ratio", "a": vals[0], "b": vals[1], "c": vals[2], "d": vals[3]}
    }
    if has(text, "=") and has(low, "x") {
        let eq = index_of(text, "=")
        let left = substring(text, 0, eq)
        let right = substring(text, eq + 1, text.len())
        let ln = regex_findall(signed_pat, left)
        let rn = regex_findall(signed_pat, right)
        if ln.len() >= 2 and rn.len() >= 1 {
            return {"kind": "linear", "a": float(ln[0]),
                    "b": float(ln[1]), "c": float(rn[0])}
        }
        return {"kind": "theorem", "text": text}
    }
    // Any purely arithmetic-looking string goes to the strict tokenizer,
    // so "2..3" and "()" get a controlled INVALID_EXPRESSION instead of
    // quietly becoming a research theorem.
    if numeric_only(text) { return {"kind": "calc", "expr": text} }
    return {"kind": "theorem", "text": text}
}

export fn ask(text) {
    let q = parse_question(text)
    let r = solve(q)
    r["question"] = text
    return r
}

// ---------------------------------------------------------------------------
// 8. The five steps, in plain language, for ANY question
// ---------------------------------------------------------------------------

fn question_text(q) {
    let k = q["kind"]
    if has_key(q, "text") { return q["text"] }
    if has_key(q, "expr") { return q["expr"] }
    if k == "percent" { return num(q["a"]) + "% of " + num(q["b"]) }
    if k == "linear" { return num(q["a"]) + "*x " + signed_term(q["b"]) + " = " + num(q["c"]) }
    if k == "sum" { return "sum 1.." + num(q["n"]) }
    if k == "ratio" { return num(q["a"]) + "/" + num(q["b"]) + " vs " + num(q["c"]) + "/" + num(q["d"]) }
    if k == "growth" { return "growth exponent " + num(q["exponent"]) }
    return k
}

export fn steps(q) {
    let raw = question_text(q)
    let s = strip(raw)
    let sh = shape_of(shape_word(q["kind"]))
    let mv = choose_move(sh["shape"], q["kind"])
    return [
        "S  Saaf karo   : " + s["skeleton"],
        "U  Uska roop   : " + expected_shape(q["kind"]) + " (" + sh["why"] + ")",
        "T  Tareeka     : move " + str(mv) + " — " + seven_moves()[mv - 1]["name"],
        "R  Rakh-jaanch : aakaar, sankhya, maatra, chhor (4 alag jaanchein)",
        "A  Answer      : " + pick(q["kind"] == "theorem", "OUT_OF_SCOPE — pramaan chahiye, shape nahi", "exact jawaab + certificate with scope")
    ]
}

// ---------------------------------------------------------------------------
// 9. Ten worked problems — class 1 to research, SAME five steps
// ---------------------------------------------------------------------------

export fn course() {
    return [
        {"level": "class 1", "text": "2+3", "q": {"kind": "calc", "expr": "2+3"}},
        {"level": "class 3", "text": "50% of 80", "q": {"kind": "percent", "a": 50.0, "b": 80.0}},
        {"level": "class 5", "text": "sum 1..100", "q": {"kind": "sum", "n": 100.0}},
        {"level": "class 7", "text": "3*x + 7 = 22", "q": {"kind": "linear", "a": 3.0, "b": 7.0, "c": 22.0}},
        {"level": "class 8", "text": "7/8 vs 11/12", "q": {"kind": "ratio", "a": 7.0, "b": 8.0, "c": 11.0, "d": 12.0}},
        {"level": "class 9", "text": "(2+3)*4^2", "q": {"kind": "calc", "expr": "(2+3)*4^2"}},
        {"level": "class 11", "text": "1/2+1/4", "q": {"kind": "calc", "expr": "1/2+1/4"}},
        {"level": "graduation", "text": "2^n vs n^2 growth shape", "q": {"kind": "growth", "exponent": 1}},
        {"level": "research", "text": "ETH refutation runtime bound", "q": {"kind": "growth", "exponent": 0}},
        {"level": "research theorem", "text": "Prove the quasi-Riemann hypothesis Re(s)>7/8", "q": {"kind": "theorem", "text": "Prove the quasi-Riemann hypothesis Re(s)>7/8"}}
    ]
}

export fn teach(i) {
    let c = course()[i]
    let r = solve(c["q"])
    var lines = []
    lines.push(c["level"] + "  |  " + c["text"])
    for s in steps(c["q"]) { lines.push("   " + s) }
    lines.push("   => " + r["answer_text"])
    if r["status"] != "SOLVED" { lines.push("   => " + r["status"] + ": " + r["reason"]) }
    return lines
}

// ---------------------------------------------------------------------------
// 10. The WHOLE openai/math catalogue — measured from the clone, not copied
// ---------------------------------------------------------------------------

fn clean_title(line) {
    var s = substring(line, 6, line.len())
    let stop = index_of(s, "**")
    if stop > 0 { s = substring(s, 0, stop) }
    return s
}

fn finish_card(cur, body) {
    let sh = shape_of(body)
    var lean = false
    if has_key(cur, "lean") { lean = cur["lean"] }
    var pdfs = 0
    if has_key(cur, "pdfs") { pdfs = cur["pdfs"] }
    var status = "MANUSCRIPT_ONLY"
    if lean { status = "FORMALIZED_IN_LEAN" }
    if has(body, "Exponential Time Hypothesis") { status = "CLAIM_UNDER_REVIEW" }
    return {"id": cur["id"], "title": cur["title"],
            "shape": sh["shape"], "move": choose_move(sh["shape"], "theorem"),
            "lean": lean, "pdfs": pdfs, "status": status,
            "sutra_can_prove": false,
            "sutra_can_do": "shape + move + 4 checks + verification map"}
}

export fn parse_catalogue(text) {
    let lines = split_lines(text)
    var cards = []
    var cur = {}
    var body = ""
    var have = false
    for line in lines {
        // A family heading is exactly "**NNN. ...". regex_search() returns
        // null (not "") when there is no match, so check the characters
        // directly instead of comparing against the empty string.
        let is_heading = line.len() > 6 and substring(line, 0, 2) == "**" and digit_char(line[2]) and digit_char(line[3]) and digit_char(line[4]) and line[5] == "."
        if is_heading {
            if have { cards.push(finish_card(cur, body)) }
            cur = {"id": substring(line, 2, 5), "title": clean_title(line)}
            body = line + " "
            // The Lean link often sits on the SAME line as the heading, e.g.
            // "**003. ...** Proves ... ([Lean](lean/docs/003.md))". Check it
            // here too, before the `continue`, or coverage reads as zero.
            if has(line, "lean/docs/") { cur["lean"] = true }
            have = true
            continue
        }
        if have {
            body = body + line + " "
            if has(line, "lean/docs/") { cur["lean"] = true }
            if has(line, "](preprints/") {
                var n = 0
                if has_key(cur, "pdfs") { n = cur["pdfs"] }
                cur["pdfs"] = n + 1
            }
        }
    }
    if have { cards.push(finish_card(cur, body)) }
    return cards
}

export fn catalogue(path) {
    return parse_catalogue(read_file(path))
}

export fn catalogue_summary(cards) {
    var shapes = {}
    var statuses = {}
    var lean = 0
    var pdfs = 0
    var claims = 0
    for c in cards {
        let s = c["shape"]
        if has_key(shapes, s) { shapes[s] = shapes[s] + 1 } else { shapes[s] = 1 }
        let st = c["status"]
        if has_key(statuses, st) { statuses[st] = statuses[st] + 1 } else { statuses[st] = 1 }
        if c["lean"] { lean = lean + 1 }
        pdfs = pdfs + c["pdfs"]
        if st == "CLAIM_UNDER_REVIEW" { claims = claims + 1 }
    }
    return {"families": cards.len(), "manuscripts": pdfs,
            "lean_families": lean, "shapes": shapes, "statuses": statuses,
            "claims_under_review": claims,
            "sutra_can_prove": 0,
            "sutra_maps": cards.len(),
            "coverage_pct": 100.0}
}

export fn measurement_notes() {
    return [
        {"measure": "245 families with a lean/docs link",
         "source": "counted from CONTENTS.md by parse_catalogue()",
         "caveat": "ye 'formalized top-line result' NAHI hai; README alag denominator (~42%) bolta hai — do alag maap hain, jodna galat hai"},
        {"measure": "244 FORMALIZED_IN_LEAN + 1 CLAIM_UNDER_REVIEW = 245",
         "source": "catalogue_summary()",
         "caveat": "ETH family ka bhi Lean link hai, par uska status alag rakha gaya kyunki daava extraordinary hai"},
        {"measure": "418 ComparatorChallenges/*.lean stubs",
         "source": "clone",
         "caveat": "challenge file me `sorry` hota hai; pramaan OAI/ ke ALAG module me hai — yahi translation gap hai"},
        {"measure": "sutra_can_prove = 0 research theorems",
         "source": "verdict()",
         "caveat": "SUTRA ne 373/373 families ka naksha banaya, ek ka bhi pramaan nahi diya"}
    ]
}

export fn status_rules() {
    return [
        {"status": "SOLVED", "meaning": "elementary question, exact answer, 4/4 checks"},
        {"status": "FORMALIZED_IN_LEAN", "meaning": "family has a Lean docs link in the catalogue; SUTRA did NOT verify the proof"},
        {"status": "MANUSCRIPT_ONLY", "meaning": "PDF without a Lean link in its family block; repo README warns some are unformalized"},
        {"status": "CLAIM_UNDER_REVIEW", "meaning": "extraordinary claim; independent review + translation gap must be checked"},
        {"status": "OUT_OF_SCOPE_FOR_SUTRA", "meaning": "research theorem — a proof is required, not a shape"}
    ]
}

// ---------------------------------------------------------------------------
// 11. The ETH claim INSIDE this very repo — measured, then bounded by SUTRA
//
// Primary evidence (the clone, not a news article):
//   history.md (Oct 26 2026)  : "The Exponential Time Hypothesis is False"
//                              + independent group Impagliazzo / Paturi /
//                                Ryan Williams "will examine and explain".
//   formalization.yaml        : source entry for the ETH paper.
//   ComparatorChallenges/SubexponentialSAT.lean : theorem stub ends `by sorry`.
//   OAI/Algorithms/SubexponentialSAT/SqrtLogSpace/Final.lean :
//                              theorem exact_count_eth, NO `sorry`.
//
// SUTRA checks the SHAPE of the claimed runtime bound with bun:eth's corrected
// invariant s = log2(T)/n. It does NOT check the proof's correctness.
// ---------------------------------------------------------------------------

export fn eth_evidence(root) {
    let hist = read_file(root + "/history.md")
    let chal = read_file(root + "/lean/ComparatorChallenges/SubexponentialSAT.lean")
    let fin = read_file(root + "/lean/OAI/Algorithms/SubexponentialSAT/SqrtLogSpace/Final.lean")
    // The stub ends with ":= by\n  sorry", so search for `sorry`, not the
    // literal two-word string "by sorry".
    return {"manuscript_announced": has(hist, "The Exponential Time Hypothesis is False"),
            "review_group_named": has(hist, "Impagliazzo") and has(hist, "Paturi") and has(hist, "Williams"),
            "challenge_stub_sorry_count": count_of(chal, "sorry"),
            "solution_sorry_count": count_of(fin, "sorry"),
            "eth_theorem_present": has(fin, "exact_count_eth"),
            "solution_theorems": count_of(fin, "theorem "),
            "translation_gap": "challenge file is a stub; the proof is in a DIFFERENT module",
            "verdict": "FORMAL_THEOREM_PRESENT / CLAIM_STILL_UNDER_REVIEW"}
}

export fn eth_bound_check() {
    // From SqrtLog.Statement in the repo's own Lean:
    //   runtimeScale(n) = n * (log(log(n+16)))^2 / sqrt(log(n+16))
    //   runtimeBound    = C * (inputBits+1)^d * 2^(A * runtimeScale(numVars))
    // bun:eth (corrected): s = log2(T)/n.  ETH false <=> s(n) -> 0.
    // Here s(n) = A * (log log n)^2 / sqrt(log n) + d*log2(poly)/n -> 0.
    var rows = []
    let ns = [1000.0, 1000000.0, 1000000000.0, 1000000000000.0, 1.0e20, 1.0e40, 1.0e100, 1.0e300]
    for n in ns {
        let l = f_log(n + 16.0)
        let s = (f_log(l) ** 2.0) / f_sqrt(l)
        rows.push({"n": n, "s_of_n": s})
    }
    return {"source": "openai/math lean/OAI/Algorithms/SubexponentialSAT/SqrtLog/Statement",
            "invariant": "s = log2(T)/n   (bun:eth, limsup-corrected)",
            "claimed_T": "C * poly(n) * 2^(A * n * (log log n)^2 / sqrt(log n))",
            "s_of_n": "A * (log log n)^2 / sqrt(log n) + d*log2(poly)/n",
            "rows": rows,
            "limit": "s(n) -> 0   =>   T = 2^o(n)   =>   ETH false IF the theorem is accepted",
            "shape_verdict": "SUBEXPONENTIAL_IN_THE_LIMIT",
            "practical_note": "s(n) ghatta hai bahut dheere; chhote n par constant bada hai — isliye 'asymptotic' aur 'vyavaharik' alag baatein hain",
            "honest_scope": "SUTRA ne bound ka AAKAAR jaancha, pramaan ki correctness NAHI",
            "eth_status": "UNDER_REVIEW (not SOLVED_BY_SUTRA)"}
}

// ---------------------------------------------------------------------------
// 12. Honest verdict + self-audit
// ---------------------------------------------------------------------------

export fn verdict() {
    return {"level": 4,
            "one_recipe": "S-U-T-R-A (5 steps, har sawaal par wahi)",
            "elementary_solved": 9,
            "elementary_total": 10,
            "research_theorems_solved_by_sutra": 0,
            "research_families_mapped": 373,
            "eth_status": "UNDER_REVIEW",
            "eth_reason": "Lean theorem hai, par independent review chal raha hai; manuscript + Lean statement ke beech translation gap bhi jaanch-na baaki hai",
            "sutra_is": "ek aasan tarika + ek imaandaar naksha",
            "sutra_is_not": "research mathematics ka proof engine",
            "rule": "jo solve kar sakte hain exact jawaab do; jo nahi, uska saaf OUT_OF_SCOPE + kyun"}
}

export fn lesson() {
    return "SUTRA = S saaf karo, U uska roop, T tareeka, R rakh-jaanch, A answer + admit scope. Paanch kadam, har sawaal."
}

