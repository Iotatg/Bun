// Adjudicate from the lattice, not from a hard-coded verdict string.
export fn adjudicate(c) {
    let checks = []
    let ok_evidence = can_settle(c["pramana"], c["type"])
    // A claim may be REFUTED precisely BECAUSE its pramana cannot reach its
    // logical type ("a benchmark can prove ETH" is false for that reason).
    // That is a correct adjudication, not an inconsistency. Only a CERTIFIED
    // or UNDER_REVIEW claim with unreachable evidence is inconsistent.
    let honest_rejection = not ok_evidence and
        (c["verdict"] == "REFUTED" or c["verdict"] == "OUT_OF_REACH")
    checks.push({"check": "evidence-type-match",
                 "pass": ok_evidence or honest_rejection,
                 "detail": c["pramana"] + " can settle " + c["type"] + ": " +
                           str(ok_evidence) +
                           pick_str(honest_rejection, " — claim rejected for exactly this mismatch", "")})

    let is_universal = c["type"] == "universal-algorithm"
    let proof_present = c["pramana"] == "anumana" and c["verdict"] == "CERTIFIED"
    checks.push({"check": "quantifier", "pass": not is_universal or c["verdict"] != "CERTIFIED" or proof_present,
                 "detail": "a CERTIFIED universal claim requires anumana"})

    checks.push({"check": "status-honesty", "pass": c["verdict"] != "OUT_OF_REACH" or c["pramana"] == "anumana",
                 "detail": "OUT_OF_REACH is reserved for claims only a proof can settle"})

    var passed = 0
    for x in checks { if x["pass"] { passed = passed + 1 } }
    var verdict = "INCONSISTENT"
    if passed == checks.len() { verdict = c["verdict"] }
    return {"id": c["id"], "text": c["text"], "declared": c["verdict"],
            "verdict": verdict, "checks": checks, "passed": passed,
            "total": checks.len(), "detail": c["detail"]}
}

export fn adjudicate_all() {
    let out = []
    for c in claims() { out.push(adjudicate(c)) }
    return out
}

