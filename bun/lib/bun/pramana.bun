// lib/bun/pramana.bun — SUTRA, level 2: प्रमाण (the evidence layer).
//
// Level 1 (bun:sutra) asks: what SHAPE is this law?
// Level 2 (bun:pramana) asks: what KIND OF EVIDENCE can settle this claim?
//
// The six pramanas are the classical means of knowledge, made executable:
//
//   pratyaksha   perception   a measurement, a run, a finite table
//   anumana      inference    a proof over all algorithms / all instances
//   upamana      comparison   a result inside a restricted model (an oracle)
//   shabda       testimony    a paper, a review panel, a press release
//   arthapatti   implication  a reduction carrying a statement across
//   anupalabdhi  absence      a barrier: what CANNOT be proved this way
//
// ETH is a universal claim over ALL algorithms. pratyaksha cannot reach it.
// That is not a limitation of the experiment; it is the LOGICAL TYPE of the
// claim. Level 1 could only say "UNDETERMINED". Level 2 says why, names the
// exact evidence that would settle it, and checks each of the 2026 claims
// against the lattice instead of against a benchmark.
//
// Everything here is data + pure arithmetic. No external state, no clock,
// no network: the same answer on all four Bun engines.
//
// HONESTY CONTRACT: this module does NOT prove or refute ETH. It classifies
// claims. Its final verdict for ETH is UNRESOLVED, matching the user's own
// correction on 2026-11-05.

import { num, fmt, has_key } from "bun:sutra"
import { alpha_blindspot, eth_worlds, s_of_ln, soft_points,
         growth_ln, eth_statement } from "bun:eth"

let M = ffi_load("math")
let f_log = M["log"]
let f_exp = M["exp"]
let f_abs = M["fabs"]
let f_sqrt = M["sqrt"]

fn lg(x) { return f_log(x) / f_log(2.0) }

// ---------------------------------------------------------------------------
// 1. The six pramanas and the claim types
// ---------------------------------------------------------------------------

export fn pramanas() {
    return [
        {"id": "pratyaksha", "sanskrit": "प्रत्यक्ष", "english": "perception",
         "is": "a measurement, one run, one finite table",
         "quantifies": "these runs only",
         "can_settle": ["existential-finite"],
         "example": "DPLL node counts for n=12..32"},
        {"id": "anumana", "sanskrit": "अनुमान", "english": "inference",
         "is": "a proof with a stated worst-case bound",
         "quantifies": "all algorithms, all instances",
         "can_settle": ["existential-finite", "universal-algorithm",
                        "universal-instance"],
         "example": "a proved 2^o(n) 3SAT algorithm; or a proved lower bound"},
        {"id": "upamana", "sanskrit": "उपमान", "english": "comparison",
         "is": "a theorem inside a restricted model",
         "quantifies": "all algorithms IN THAT MODEL",
         "can_settle": ["model-bound"],
         "example": "BBBV: Omega(sqrt(N)) quantum queries for black-box search"},
        {"id": "shabda", "sanskrit": "शब्द", "english": "testimony",
         "is": "a paper, a review panel, a press release",
         "quantifies": "social record only",
         "can_settle": ["social-record"],
         "example": "open letter: participation is not certification"},
        {"id": "arthapatti", "sanskrit": "अर्थापत्ति", "english": "implication",
         "is": "a reduction transferring a statement",
         "quantifies": "whatever the reduction preserves",
         "can_settle": ["reduction"],
         "example": "sparsification lemma: ETH for m=O(n) <=> ETH for 3SAT"},
        {"id": "anupalabdhi", "sanskrit": "अनुपलब्धि", "english": "absence",
         "is": "a barrier ruling out a proof technique",
         "quantifies": "proof methods",
         "can_settle": ["impossibility"],
         "example": "relativization, natural proofs, algebrization"}
    ]
}

export fn claim_types() {
    return [
        {"id": "existential-finite", "shape": "there exist runs with these numbers",
         "needs": ["pratyaksha", "anumana"]},
        {"id": "universal-algorithm", "shape": "for every algorithm, for all inputs",
         "needs": ["anumana"]},
        {"id": "universal-instance", "shape": "for every instance, worst case",
         "needs": ["anumana"]},
        {"id": "model-bound", "shape": "for every algorithm inside a restricted model",
         "needs": ["upamana"]},
        {"id": "reduction", "shape": "statement A and statement B stand or fall together",
         "needs": ["arthapatti"]},
        {"id": "impossibility", "shape": "this proof technique cannot work",
         "needs": ["anupalabdhi"]},
        {"id": "social-record", "shape": "who announced what, and who reviewed it",
         "needs": ["shabda"]}
    ]
}

// The lattice, computed rather than asserted: can THIS pramana settle THAT
// claim type? `settles` is the single source of truth used by adjudicate().
export fn can_settle(pramana_id, claim_type) {
    for p in pramanas() {
        if p["id"] == pramana_id {
            for c in p["can_settle"] {
                if c == claim_type { return true }
            }
        }
    }
    return false
}

export fn lattice() {
    let out = []
    for p in pramanas() {
        let row = []
        for c in claim_types() {
            row.push({"claim": c["id"], "ok": can_settle(p["id"], c["id"])})
        }
        out.push({"pramana": p["id"], "row": row})
    }
    return out
}

// The theorem that closes the "can a benchmark decide ETH?" question.
export fn measurement_theorem() {
    let e = eth_statement()
    return {
        "claim": e["claim"],
        "claim_type": "universal-algorithm",
        "available": "pratyaksha (finite measurement)",
        "can_settle": can_settle("pratyaksha", "universal-algorithm"),
        "reason": "a finite table quantifies over the runs performed; ETH quantifies over all possible algorithms and all instances",
        "consequence": "no amount of benchmarking can certify or refute ETH",
        "what_would": "anumana: a proof with a worst-case bound",
        "status": "PROVED (by logical type, not by experiment)"
    }
}

// ---------------------------------------------------------------------------
// 2. Quantum: Grover, BBBV, and the difference a model makes
//
// Search over N = 2^n truth assignments. Classically N queries. Grover uses
// sqrt(N) = 2^(n/2). BBBV (1997) PROVES Omega(sqrt(N)) queries are necessary
// in the black-box model. That is a genuine universal theorem — but only
// INSIDE the model, so it is upamana, not anumana over real 3SAT.
//
//   s = log2(T)/n
//   classical 2^n      -> s = 1        (ETH-shape true)
//   Grover   2^(n/2)   -> s = 0.5      (ETH-shape STILL true)
//   2^o(n) algorithm   -> s -> 0       (ETH false)
//
// Quantum halves the exponent. It does not change the shape. That is why a
// quantum computer does not refute ETH by itself.
// ---------------------------------------------------------------------------

export fn grover_queries(n) {
    return f_exp(0.5 * float(n) * f_log(2.0))
}

export fn bbbv_lower_bound(n) {
    // Omega(sqrt(N)) with the constant normalised to 1 for the statement.
    return f_exp(0.5 * float(n) * f_log(2.0))
}

export fn quantum_s(n) {
    return 0.5
}

export fn quantum_certificate() {
    let checks = []
    // shape
    checks.push({"check": "shape", "pass": quantum_s(100) > 0.0,
                 "detail": "s = 0.5 > 0 for 2^(n/2); the exponent density does not vanish"})
    // number
    let q = grover_queries(20)
    let want = 1024.0
    checks.push({"check": "number", "pass": f_abs(q - want) < 1e-6,
                 "detail": "Grover at n=20 needs " + num(q) + " = 2^10 queries, vs 2^20 classically"})
    // dimension
    checks.push({"check": "dimension", "pass": q > 0.0 and bbbv_lower_bound(20) > 0.0,
                 "detail": "query counts are positive integers"})
    // boundary
    checks.push({"check": "boundary", "pass": grover_queries(40) > grover_queries(20),
                 "detail": "2^20 > 2^10; the search grows with n"})
    // model restriction — the new, fifth check
    checks.push({"check": "model", "pass": true,
                 "detail": "BBBV holds in the BLACK-BOX model; 3SAT has structure, so this is upamana, not a proof about 3SAT"})
    var passed = 0
    for c in checks { if c["pass"] { passed = passed + 1 } }
    return {"id": "quantum-does-not-refute-eth", "checks": checks,
            "passed": passed, "total": checks.len(),
            "verdict": "CERTIFIED (model-bound)",
            "conclusion": "quadratic speedup changes the base, not the shape; ETH-shape survives"}
}

export fn quantum_worlds() {
    return [
        {"name": "classical brute force", "T": "2^n", "s": 1.0,
         "eth_shape": "true", "evidence": "pratyaksha"},
        {"name": "Grover / BBBV", "T": "2^(n/2)", "s": 0.5,
         "eth_shape": "true", "evidence": "upamana (proved in model)"},
        {"name": "hypothetical 2^o(n)", "T": "exp(n/sqrt(log n))", "s": 0.0,
         "eth_shape": "false", "evidence": "anumana required, not yet available"}
    ]
}

// ---------------------------------------------------------------------------
// 3. Barriers: why a proof of ETH (in either direction) is hard
// ---------------------------------------------------------------------------

export fn barriers() {
    return [
        {"id": "relativization", "year": 1975,
         "authors": "Baker, Gill, Solovay",
         "statement": "some oracles make P=NP, others make P!=NP; any resolving proof must be non-relativizing",
         "effect": "rules out diagonalisation/simulation proofs for P vs NP"},
        {"id": "natural-proofs", "year": 1997,
         "authors": "Razborov, Rudich",
         "statement": "a large class of combinatorial lower-bound techniques would also break pseudorandom generators",
         "effect": "rules out 'natural' circuit lower bounds under standard assumptions"},
        {"id": "algebrization", "year": 2009,
         "authors": "Aaronson, Wigderson",
         "statement": "even non-relativizing algebraic techniques (e.g. IP=PSPACE) algebrize and still cannot resolve P vs NP",
         "effect": "extends the relativization barrier to algebraic methods"},
        {"id": "eth-implies-pneqnp", "year": 1999,
         "authors": "Impagliazzo, Paturi",
         "statement": "ETH implies P != NP, since a polynomial algorithm is 2^o(n)",
         "effect": "proving ETH TRUE would also prove P != NP, and must cross all three barriers"},
        {"id": "sparsification", "year": 2001,
         "authors": "Impagliazzo, Paturi, Zane",
         "statement": "ETH for 3SAT is equivalent to ETH for 3SAT with m = O(n) clauses",
         "effect": "a 2^o(n) algorithm on linear-size formulas WOULD refute ETH — the 2026 claims live here"}
    ]
}

export fn asymmetries() {
    return {
        "to_refute": "exhibit ONE algorithm + prove a worst-case 2^o(n) bound for every instance (anumana, existential witness)",
        "to_prove": "prove a lower bound for EVERY algorithm (anumana, universal) — and cross the three barriers",
        "why_asymmetric": "one witness falsifies a universal claim; no number of witnesses proves one",
        "benchmark_role": "none for the theorem; useful only for calibrating algorithms",
        "note": "this asymmetry is the whole reason ETH has stayed open since 1999"
    }
}

