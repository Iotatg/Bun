// 5. What would actually settle it
// ---------------------------------------------------------------------------

export fn settle_conditions() {
    return [
        {"direction": "ETH is FALSE",
         "needs": ["one explicit algorithm A", "a proof that for every instance of size n, T_A(n) = 2^o(n)",
                   "the proof checked independently by the community",
                   "Lean (or similar) derivation matched to the informal statement",
                   "raw data and the actual bound made public"],
         "pramana": "anumana + arthapatti",
         "status": "claimed 2026-10-16/26, UNDER_REVIEW as of 2026-11-05"},
        {"direction": "ETH is TRUE",
         "needs": ["a lower bound 2^(s n), s>0, for EVERY algorithm",
                   "a non-relativizing, non-natural, non-algebrizing technique",
                   "which would also prove P != NP"],
         "pramana": "anumana, crossing all three barriers",
         "status": "no known route"},
        {"direction": "ETH is UNRESOLVED (current)",
         "needs": ["nothing further — this is the honest default"],
         "pramana": "anupalabdhi + shabda",
         "status": "CERTIFIED as of 2026-11-05"}
    ]
}

// ---------------------------------------------------------------------------
// 6. The mystery verdict
//
// Two different questions, two different answers. Conflating them is the
// error the whole exercise started with.
// ---------------------------------------------------------------------------

export fn mystery_verdict() {
    let b = alpha_blindspot()
    let mt = measurement_theorem()
    let counts = verdict_counts()
    return {
        "eth": "UNRESOLVED",
        "eth_reason": "universal claim over all algorithms; no anumana accepted in either direction; 2026 AI claims still under independent review",
        "mystery": "SOLVED",
        "mystery_meaning": "why ETH is unresolved, why no benchmark can decide it, what each 2026 claim does and does not establish, and what evidence would settle it",
        "solved_by": [
            "correct invariant: s = log2(T)/n, not alpha",
            "alpha blindspot reproduced: alpha = " + fmt(b["alpha"]) + " says exponential, s -> 0 says 2^o(n)",
            "evidence lattice: pratyaksha cannot reach a universal-algorithm claim",
            "quantum: Grover halves s (0.5) but BBBV is proved only in the black-box model",
            "barriers: proving ETH true would also prove P != NP",
            "2026 ledger: 13 claims adjudicated, review status explicit"
        ],
        "not_solved_by": "any finite experiment, any Lean file alone, any press release, any authority",
        "user_correction": "honoured verbatim: SUTRA analysed and tested ETH-related claims; it did not solve ETH",
        "claims": counts,
        "measurement_can_settle_eth": mt["can_settle"]
    }
}

export fn verdict_counts() {
    var d = {}
    for c in claims() {
        let v = c["verdict"]
        if has_key(d, v) { d[v] = d[v] + 1 }
        if not has_key(d, v) { d[v] = 1 }
    }
    return d
}

// ---------------------------------------------------------------------------
// 7. Self-audit: the module checks its own instruments
// ---------------------------------------------------------------------------

export fn audit() {
    let checks = []
    // 1. six pramanas
    checks.push({"check": "six-pramanas", "pass": pramanas().len() == 6,
                 "detail": "pratyaksha, anumana, upamana, shabda, arthapatti, anupalabdhi"})
    // 2. measurement cannot settle ETH
    checks.push({"check": "measurement-limit", "pass": not can_settle("pratyaksha", "universal-algorithm"),
                 "detail": "finite runs are not a proof over all algorithms"})
    // 3. proof can
    checks.push({"check": "proof-reaches", "pass": can_settle("anumana", "universal-algorithm"),
                 "detail": "anumana is the only pramana that reaches ETH"})
    // 4. the alpha contradiction reproduces
    let b = alpha_blindspot()
    checks.push({"check": "alpha-blindspot", "pass": b["contradiction"],
                 "detail": "alpha = " + fmt(b["alpha"]) + " (exponential) vs s -> 0 (2^o(n))"})
    // 5. quantum numbers
    checks.push({"check": "grover-number", "pass": f_abs(grover_queries(20) - 1024.0) < 1e-6,
                 "detail": "sqrt(2^20) = 2^10 = 1024"})
    // 6. quantum shape
    checks.push({"check": "quantum-shape", "pass": quantum_s(100) > 0.0,
                 "detail": "s = 0.5, so a quadratic speedup does not refute ETH"})
    // 7. every claim is adjudicated consistently
    var all_ok = true
    for a in adjudicate_all() {
        if a["verdict"] == "INCONSISTENT" { all_ok = false }
    }
    checks.push({"check": "claim-ledger-consistent", "pass": all_ok,
                 "detail": str(claims().len()) + " claims, each verdict matches its evidence type"})
    // 8. the final answer is honest
    let mv = mystery_verdict()
    checks.push({"check": "eth-stays-unresolved", "pass": mv["eth"] == "UNRESOLVED",
                 "detail": "the module does not claim to have proved or refuted ETH"})
    // 9. timeline ordered and complete
    checks.push({"check": "timeline-dated", "pass": timeline().len() >= 10,
                 "detail": str(timeline().len()) + " dated events, 1955 -> 2026-11-05"})
    // 10. sources cited
    checks.push({"check": "sources-cited", "pass": sources().len() >= 5,
                 "detail": str(sources().len()) + " sources, each with a URL"})

    var passed = 0
    for c in checks { if c["pass"] { passed = passed + 1 } }
    var verdict = "FAILED"
    if passed == checks.len() { verdict = "CERTIFIED" }
    return {"verdict": verdict, "passed": passed, "total": checks.len(),
            "checks": checks}
}

// ---------------------------------------------------------------------------
// 8. The single shape of the whole method — for teaching
// ---------------------------------------------------------------------------

export fn lesson() {
    return [
        "1. पहले दावे का LOGICAL TYPE पूछो: क्या यह 'सभी algorithms' के बारे में है?",
        "2. फिर प्रमाण पूछो: क्या measurement (प्रत्यक्ष) उस type तक पहुँचता है?",
        "3. यदि नहीं, तो 'UNDETERMINED' कहो — पर कारण के साथ, और बताओ क्या चाहिए।",
        "4. सही invariant चुनो: ETH के लिए s = log2(T)/n, alpha नहीं।",
        "5. घात में छोटा सुधार और 2^o(n) एक बात नहीं: 0.99 बचा, 1/sqrt(log n) गिराता है।",
        "6. Lean derivation जाँचता है, premise-दुनिया मेल नहीं; review panel certification नहीं।",
        "7. Quantum model में सार्वत्रिक प्रमेय संभव है (BBBV), पर वही real 3SAT पर लागू नहीं।",
        "8. अंतिम उत्तर: ETH UNRESOLVED. Mystery solved — क्यों, कैसे, और किस evidence से।"
    ]
}

fn pick_str(cond, a, b) {
    if cond { return a }
    return b
}
