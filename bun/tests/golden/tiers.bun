// A program that uses the whole language of Bun.
// Every engine and every tier of the machine must print the same thing,
// byte for byte.  The rule of the phase: a program that prints something
// different under another engine is a bug in the tier, never a difference
// in the language.

fn fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn classify(n) {
    match n {
        0 => { return "zero" }
        1 to 9 => { return "small" }
        n if n < 0 => { return "negative" }
        _ => { return "big" }
    }
}

fn greet(name) {
    return "hello, " + name
}

fn ctx(label) {
    return {
        "__enter__": fn() { return label },
        "__exit__": fn(err) { return false }
    }
}

let numbers = [5, 3, 8, 1]
let doubled = [n * 2 for n in numbers]
print("doubled: " + doubled.join(","))

var total = 0
for n in doubled {
    total = total + n
}
print("total: " + str(total))

let scores = { "ann": 10, "bob": 20 }
for name in scores {
    print(name + "=" + str(scores[name]))
}

let text = "the quick brown fox"
let words = text.split(" ")
let counts = {}
var i = 0
while i < len(words) {
    let w = words[i]
    if !counts.has(w) {
        counts[w] = 1
    } else {
        counts[w] = counts[w] + 1
    }
    i = i + 1
}
print("words: " + str(len(words)) + " unique: " + str(len(counts.keys())))

print(greet("bun"))
print("fib: " + str(fib(10)))
print("classify: " + classify(5) + " " + classify(0) + " " + classify(50))

let middle = numbers[1:3]
print("slice: " + middle.join(","))

var squares = []
for n in [1, 2, 3, 4] {
    squares.push(n * n)
}
print("squares: " + squares.join(" "))

let pair = [1, 2]
let first = pair[0]
let second = pair[1]
print("unpack: " + str(first + second))

try {
    throw "boom"
} catch err {
    print("caught: " + err)
}

assert total > 0
assert total == 34, "the total is wrong"

with ctx("x") as value {
    print("with: " + value)
}

scope {
    print("in scope")
}

var counter = 0
for n in numbers {
    if n == 3 {
        continue
    }
    if n == 1 {
        break
    }
    counter = counter + n
}
print("counter: " + str(counter))

print("not: " + str(not true))
