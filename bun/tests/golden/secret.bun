var token = secret("hunter2")

print(token)
print(str(token))
print(dump(token))
print(type_of(token))
print(token.reveal())

var config = {
    "api_key": token,
    "name": "demo"
}
print(dump(config))
print(config)
print([token])
print(f"token={token}")

try {
    throw token
} catch e {
    print("caught " + e)
}

print(secret(1) == secret(1))
print(secret(1) == secret(2))
