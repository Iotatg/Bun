fn halve(n: int) -> result {
    if n % 2 != 0 {
        return Err("odd")
    }
    return Ok(n / 2)
}

fn lookup(table: dict, key: string) -> option {
    if table.has(key) {
        return some(table[key])
    }
    return none()
}

fn unwrap(table: dict) -> option {
    let found = lookup(table, "b")?
    print(found)
    return none()
}

let half = halve(4)
if is_ok(half) {
    print(half["ok"])
}

let odd = halve(7)
print(odd)
print(odd["err"])

print(is_some(lookup({"a": 1}, "b")))
print(is_none(lookup({"a": 1}, "b")))
print(is_some(lookup({"a": 1}, "a")))
let table = {"x": 5}
print(unwrap(table))
