let pair = [1, 2]
let a, b = pair
print(a)
print(b)

var x, y = [10, 20]
print(x + y)

let items = [1, 2, 3, 4, 5]
let first, *rest = items
print(first)
print(rest)

let [p, q] = [7, 8]
print(p)
print(q)

let nested = [[1, 2], [3, 4]]
let [m, n] = nested
print(m)
print(n)

let [s, t, u] = [1, 2, 3]
print(s)
print(t)
print(u)

var alpha = 0
var beta = 0
alpha, beta = [5, 6]
print(alpha)
print(beta)

var gamma = 0
[gamma] = [42]
print(gamma)

var delta = 0
var epsilon = 0
[delta, epsilon] = [1, 2]
print(delta)
print(epsilon)

let text = "hi"
let ch1, ch2 = text
print(ch1)
print(ch2)

let single, *nothing = [9]
print(single)
print(nothing)

fn pair_of() -> list {
    return [11, 22]
}

let [left, right] = pair_of()
print(left)
print(right)
