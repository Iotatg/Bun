}

fn is_known_type(name) {
    return TYPES.has(name)
}

// The name of a type, without its type arguments: the type
// `list<int>` has the base `list`.
fn base_type(name) {
    if name == null {
        return null
    }
    let index = index_of(name, "<")
    if index < 0 {
        return name
    }
    return substring(name, 0, index)
}

// The type arguments of a type: the type `list<int>` has the argument
// `int`, and the type `int` has no argument.
fn type_args(name) {
    if name == null {
        return []
    }
    let index = index_of(name, "<")
    if index < 0 {
        return []
    }
    let inner = substring(name, index + 1, len(name) - 1)
    let parts = split(inner, ",")
    var result = []
    var i = 0
    while i < parts.len() {
        result.push(trim(parts[i]))
        i = i + 1
    }
    return result
}

// The bounds a type parameter may carry. A bound with an empty set is
// satisfied by every type.
fn bound_types(bound) {
    if bound == "Num" {
        return ["int", "float"]
    }
    if bound == "Ord" {
        return ["int", "float", "string"]
    }
    if bound == "Hash" {
        return ["int", "float", "string", "bool"]
    }
    return []
}

// Report whether a type satisfies a bound. The type `any` satisfies
// every bound: it is the way out of the check of a type.
fn satisfies_bound(name, bound) {
    if bound == null {
        return true
    }
    if name == "any" {
        return true
    }
    let allowed = bound_types(bound)
    if allowed.len() == 0 {
        return true
    }
    var i = 0
    while i < allowed.len() {
        if allowed[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn is_assignable(source, target) {
    if ALIASES.has(source) {
        source = ALIASES[source]
    }
    if ALIASES.has(target) {
        target = ALIASES[target]
    }
    if source == target {
        return true
    }
    if source == "any" or target == "any" {
        return true
    }
    if source == "int" and target == "float" {
        return true
    }
    if source == "null" {
        return true
    }
    // A type with type arguments is a type with the same name: the
    // arguments of a container are a promise of the program, not a
    // check of the language.
    let source_base = base_type(source)
    let target_base = base_type(target)
    if source_base != source or target_base != target {
        return source_base == target_base
    }
    return false
}

fn node_line(node) {
    if node.has("line") {
        return node["line"]
    }
    return 0
}

fn node_col(node) {
    if node.has("col") {
        return node["col"]
    }
    return 0
}

fn fail(message, node) {
    type_error(message, node_line(node), node_col(node))
}

fn make_binding(kind) {
    return {"type": kind, "params": null, "return_type": null, "mutable": true, "type_params": null}
}

fn make_immutable_binding(kind) {
    return {"type": kind, "params": null, "return_type": null, "mutable": false, "type_params": null}
}

fn make_fn_binding(params, ret) {
    return {"type": "fn", "params": params, "return_type": ret, "mutable": true, "type_params": null}
}

fn make_immutable_fn_binding(params, ret) {
    return {"type": "fn", "params": params, "return_type": ret, "mutable": false, "type_params": null}
}

fn param_specs(decl) {
    let result = []
    let params = decl["params"]
    var i = 0
    while i < params.len() {
        let param = params[i]
        var has_default = false
        if param["default"] != null {
            has_default = true
        }
        result.push({"name": param["name"], "type": param["type_name"], "param_kind": param["param_kind"], "has_default": has_default})
        i = i + 1
    }
    return result
}

fn copy_scope(scope) {
    let result = {}
    let keys = scope.keys()
    var i = 0
    while i < keys.len() {
        result[keys[i]] = scope[keys[i]]
        i = i + 1
    }
    return result
}

fn make_state(base_dir) {
    return {"base_dir": base_dir, "return_stack": [], "module_cache": {}, "module_loading": {}, "loop_depth": 0, "module_names": {}, "name_stack": [], "function_depth": 0, "structs": {}, "enums": {}, "impls": {}, "protocols": {}, "checking_method": null, "type_vars": []}
}

fn check_annotation(state, name, node) {
    if name == null {
        return
    }
    if is_type_var(state, name) {
        return
    }
    let base = base_type(name)
    if is_known_type(base) or state["structs"].has(base) or state["enums"].has(base) {
        let args = type_args(name)
        var i = 0
        while i < args.len() {
            check_annotation(state, args[i], node)
            i = i + 1
        }
        return
    }
    if state["protocols"].has(name) {
        return
    }
    fail("unknown type '" + name + "'", node)
}

fn check_annotation_throw(state, name) {
    if name == null {
        return
    }
    if is_type_var(state, name) {
        return
    }
    let base = base_type(name)
    if is_known_type(base) or state["structs"].has(base) or state["enums"].has(base) {
        return
    }
    if state["protocols"].has(name) {
        return
    }
    throw "unknown type '" + name + "'"
}

// Make the type parameters of a function the types in scope. A type
// parameter is a name of a type that is not known yet, so the body of
// the function is checked with it in place of a type.
fn push_type_vars(state, decl) {
    let frame = {}
    let seen = {}
    let params = decl["type_params"]
    var i = 0
    while i < params.len() {
        let param = params[i]
        if seen.has(param["name"]) {
            fail("duplicate type parameter '" + param["name"] + "'", param)
        }
        if param["bound"] != null and !is_known_bound(param["bound"]) {
            fail("unknown bound '" + param["bound"] + "'", param)
        }
        seen[param["name"]] = true
        frame[param["name"]] = param["bound"]
        i = i + 1
    }
    state["type_vars"].push(frame)
}

fn pop_type_vars(state) {
    state["type_vars"].pop()
}

// Report whether a name is a type parameter in scope.
fn is_type_var(state, name) {
    let frames = state["type_vars"]
    var i = frames.len() - 1
    while i >= 0 {
        if frames[i].has(name) {
            return true
        }
        i = i - 1
    }
    return false
}

// The bound of a type parameter in scope.
fn type_var_bound(state, name) {
    let frames = state["type_vars"]
    var i = frames.len() - 1
    while i >= 0 {
        if frames[i].has(name) {
            return frames[i][name]
        }
        i = i - 1
    }
    return null
}

fn is_known_bound(name) {
    return name == "Num" or name == "Ord" or name == "Eq" or name == "Hash" or name == "Show"
}

fn collect_functions(statements, scope) {
    var i = 0
    while i < statements.len() {
        let statement = statements[i]
        if statement["kind"] == "FnDecl" {
            let binding = make_immutable_fn_binding(param_specs(statement), statement["return_type"])
            binding["type_params"] = statement["type_params"]
            scope[statement["name"]] = binding
        }
        i = i + 1
    }
}

// Collect the structs of the program and the methods of their impl
// blocks. The declarations are collected before the statements are
// checked, so a constructor may be called before the declaration that
// names it.
fn collect_structs(state, statements, scope) {
    var i = 0
    while i < statements.len() {
        let statement = statements[i]
        if statement["kind"] == "StructDecl" {
            state["structs"][statement["name"]] = statement
            scope[statement["name"]] = make_immutable_binding("struct")
        } else {
            if statement["kind"] == "ImplDecl" {
                let methods = state["impls"]
                let type_name = statement["type_name"]
                if !methods.has(type_name) {
                    methods[type_name] = {}
                }
                let table = methods[type_name]
                let list = statement["methods"]
                var k = 0
                while k < list.len() {
                    table[list[k]["name"]] = list[k]
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
}

// Collect the enums of the program. The enums are collected before the
// statements are checked, so an enum may be used before the declaration
// that names it, the way a struct may.
fn collect_enums(state, statements) {
    var i = 0
    while i < statements.len() {
        let statement = statements[i]
        if statement["kind"] == "EnumDecl" {
            let table = {}
            let variants = statement["variants"]
            var k = 0
            while k < variants.len() {
                table[variants[k]["name"]] = variants[k]["field_types"]
                k = k + 1
            }
            state["enums"][statement["name"]] = table
        }
        i = i + 1
    }
}

// Collect the protocols of the program. The protocols are collected// before the statements are checked, so a protocol may be used before
// the declaration that names it.
fn collect_protocols(state, statements) {
    var i = 0
    while i < statements.len() {
        let statement = statements[i]
        if statement["kind"] == "ProtocolDecl" {
            let methods = {}
            let list = statement["methods"]
            var k = 0
            while k < list.len() {
                methods[list[k]["name"]] = list[k]
                k = k + 1
            }
            state["protocols"][statement["name"]] = methods
        }
        i = i + 1
    }
}

// The first method of a protocol that a type does not have. A protocol
// is satisfied by a type that has every method of the protocol, so the
// check of a protocol is a check of the methods.
fn missing_method(state, source, protocol_name) {
    if source == "any" {
        return null
    }
    var methods = {}
    if state["protocols"].has(source) {
        methods = state["protocols"][source]
    } else {
        if state["impls"].has(source) {
            methods = state["impls"][source]
        }
    }
    let wanted = state["protocols"][protocol_name]
    let names = wanted.keys()
    var i = 0
    while i < names.len() {
        if !methods.has(names[i]) {
            return names[i]
        }
        i = i + 1
    }
    return null
}

// Check that a value of the source type fits the target type. The
// message is written only when the check fails. A protocol says which
// method is missing, because that is the part the program has to add.
fn check_assignable(state, source, target, node, kind, name) {
    if state["protocols"].has(target) {
        let missing = missing_method(state, source, target)
        if missing != null {
            fail("type '" + source + "' does not satisfy protocol '" + target + "': missing method '" + missing + "'", node)
        }
        return
    }
    if is_type_var(state, target) {
        let bound = type_var_bound(state, target)
        // A type parameter satisfies the bound of another type
        // parameter: the type is not known yet.
        if !is_type_var(state, source) and !satisfies_bound(source, bound) {
            fail(assign_message(kind, source, target, name), node)
        }
        return
    }
    if is_assignable(source, target) {
        return
    }
    fail(assign_message(kind, source, target, name), node)
}

// The message of a value that does not fit the type it is given.
fn assign_message(kind, source, target, name) {
    if kind == "variable" {
        return "cannot assign value of type '" + source + "' to variable '" + name + "' of type '" + target + "'"
    }
    if kind == "return" {
        return "cannot return value of type '" + source + "' from function with return type '" + target + "'"
    }
    return "argument of type '" + source + "' is not assignable to parameter of type '" + target + "' in call to '" + name + "'"
}

// Check the call of a generic function and give its type. The type
// arguments are found by matching the declared types of the parameters
// with the types of the arguments. A type argument that cannot be
// found is `any`, a bound that the type does not satisfy is an error,
// and the type of the call is the declared return type with the type
// arguments put in place of the type parameters.
fn generic_call(state, name, binding, node, arg_types, kwarg_types, scope) {
    var type_params = binding["type_params"]
    if type_params == null {
        type_params = []
    }
    let type_vars = {}
    var i = 0
    while i < type_params.len() {
        type_vars[type_params[i]["name"]] = true
        i = i + 1
    }
    let bindings = {}
    var specs = binding["params"]
    if specs == null {
        specs = []
    }
    let positional = []
    var known = {}
    i = 0
    while i < specs.len() {
        if specs[i]["param_kind"] == "positional" {
            positional.push(specs[i])
        }
        known[specs[i]["name"]] = specs[i]
        i = i + 1
    }
    let args = node["args"]
    i = 0
    while i < args.len() {
        if i >= positional.len() {
            break
        }
        let declared = positional[i]["type"]
        if declared != null {
            unify(declared, infer_type(state, args[i], scope), type_vars, bindings)
        }
        i = i + 1
    }
    let kwargs = node["kwargs"]
    i = 0
    while i < kwargs.len() {
        let spec = known[kwargs[i][0]]
        if spec != null and spec["type"] != null {
            unify(spec["type"], infer_type(state, kwargs[i][1], scope), type_vars, bindings)
        }
        i = i + 1
    }
    i = 0
    while i < type_params.len() {
        let param = type_params[i]
        var found = "any"
        if bindings.has(param["name"]) {
            found = bindings[param["name"]]
        }
        if !satisfies_bound(found, param["bound"]) {
            fail("type '" + found + "' does not satisfy the bound '" + param["bound"] + "' of type parameter '" + param["name"] + "'", node)
        }
        i = i + 1
    }
    let effective = []
    i = 0
    while i < specs.len() {
        let spec = specs[i]
        let filled = {}
        let keys = spec.keys()
        var k = 0
        while k < keys.len() {
            filled[keys[k]] = spec[keys[k]]
            k = k + 1
        }
        filled["type"] = substitute(spec["type"], bindings, type_vars)
        effective.push(filled)
        i = i + 1
    }
    check_call_args(state, name, effective, arg_types, kwarg_types, node)
    let result = substitute(binding["return_type"], bindings, type_vars)
    if result == null {
        return "any"
    }
    return result
}

// Match a declared type with the type of an argument. A type parameter
// that is not known yet takes the type of the argument. A type with
// type arguments is matched argument by argument, so the type of a
// list gives the type of its elements.
fn unify(declared, actual, type_vars, bindings) {
    if declared == null {
        return
    }
    if type_vars.has(declared) {
        if !bindings.has(declared) {
            bindings[declared] = actual
        }
        return
    }
    let args = type_args(declared)
    if args.len() == 0 {
        return
    }
    let actual_args = type_args(actual)
    var i = 0
    while i < args.len() {
        if i >= actual_args.len() {
            break
        }
        unify(args[i], actual_args[i], type_vars, bindings)
        i = i + 1
    }
}

// Put the type arguments in place of the type parameters.
fn substitute(name, bindings, type_vars) {
    if name == null {
        return null
    }
    if type_vars.has(name) {
        if bindings.has(name) {
            return bindings[name]
        }
        return "any"
    }
    let args = type_args(name)
    if args.len() == 0 {
        return name
    }
    var i = 0
    let filled = []
    while i < args.len() {
        filled.push(substitute(args[i], bindings, type_vars))
        i = i + 1
    }
    return base_type(name) + "<" + join_types(filled) + ">"
}

// The type of an expression, with the type of a literal worked out. A
// list of integers is a `list<int>` and not a `list`: the type
// arguments of a generic function are found with it.
fn infer_type(state, node, scope) {
    if node["kind"] == "ListLiteral" {
        let elements = node["elements"]
        if elements.len() == 0 {
            return "list"
        }
        var element = null
        var i = 0
        while i < elements.len() {
            let item_type = infer_type(state, elements[i], scope)
            if element == null {
                element = item_type
            } else {
                if element != item_type {
                    element = "any"
                }
            }
            i = i + 1
        }
        return "list<" + element + ">"
    }
    return check_expr(state, node, scope)
}

// The type of the elements of a container. The type of a `list<int>`
// gives `int`, and the type of a `list` gives nothing: the type of the
// elements is not known.
fn element_type(name) {
    if name == null {
        return null
    }
    let base = base_type(name)
    let args = type_args(name)
    if (base == "list" or base == "set") and args.len() > 0 {
        return args[0]
    }
    if base == "dict" and args.len() > 1 {
        return args[1]
    }
    return null
}

// Collect the names the module binds. The names are collected before the
// statements are checked, so a function may use a variable of the module
// that is defined further down.
fn collect_module_names(state, statements) {
    let names = state["module_names"]
    var i = 0
    while i < statements.len() {
        let statement = statements[i]
        let kind = statement["kind"]
        if kind == "LetStmt" {
            names[statement["name"]] = true
        } else if kind == "FnDecl" {
            names[statement["name"]] = true
        } else if kind == "StructDecl" {
            names[statement["name"]] = true
        } else if kind == "EnumDecl" {
            names[statement["name"]] = true
        } else if kind == "ProtocolDecl" {
            names[statement["name"]] = true
        } else if kind == "UnpackStmt" {
            let unpacked = unpack_names(statement["targets"])
            var k = 0
            while k < unpacked.len() {
                names[unpacked[k]] = true
                k = k + 1
            }
        } else if kind == "ImportStmt" {
            let imported = statement["names"]
            var k = 0
            while k < imported.len() {
                names[imported[k]] = true
                k = k + 1
            }
        }
        i = i + 1
    }
}

// Collect the names a block binds. The names are collected for the whole
// block, so a name may be used before the statement that binds it.
fn bound_names(statements) {
    let names = {}
    var i = 0
    while i < statements.len() {
        collect_bound_names(statements[i], names)
        i = i + 1
    }
    return names
}

fn collect_bound_names(node, names) {
    let kind = node["kind"]
    if kind == "LetStmt" {
        names[node["name"]] = true
        return
    }
    if kind == "FnDecl" {
        names[node["name"]] = true
        return
    }
    if kind == "StructDecl" {
        names[node["name"]] = true
        return
    }
    if kind == "EnumDecl" {
        names[node["name"]] = true
        return
    }
    if kind == "ProtocolDecl" {
        names[node["name"]] = true
        return
    }
    if kind == "AssignStmt" {
        let target = node["target"]
        if target["kind"] == "Identifier" {
            names[target["name"]] = true
        } else if target["kind"] == "UnpackTarget" {
            let unpacked = unpack_names([target])
            var i = 0
            while i < unpacked.len() {
                names[unpacked[i]] = true
                i = i + 1
            }
        }
        return
    }
    if kind == "UnpackStmt" {
        let unpacked = unpack_names(node["targets"])
        var i = 0
        while i < unpacked.len() {
            names[unpacked[i]] = true
            i = i + 1
        }
        return
    }
    if kind == "ForStmt" {
        let targets = node["targets"]
        var i = 0
        while i < targets.len() {
            names[targets[i]] = true
            i = i + 1
        }
        collect_block_names(node["body"], names)
        if node["orelse"] != null {
            collect_block_names(node["orelse"], names)
        }
        return
    }
    if kind == "MatchStmt" {
        let cases = node["cases"]
        var i = 0
        while i < cases.len() {
            let bound = pattern_names(cases[i][0])
            var j = 0
            while j < bound.len() {
                names[bound[j]] = true
                j = j + 1
            }
            collect_block_names(cases[i][1], names)
            i = i + 1
        }
        return
    }
    if kind == "TryStmt" {
        let params = node["catch_params"]
        var i = 0
        while i < params.len() {
            names[params[i]] = true
            i = i + 1
        }
        collect_block_names(node["try_block"], names)
        if node["catch_block"] != null {
            collect_block_names(node["catch_block"], names)
        }
        if node["finally_body"] != null {
            collect_block_names(node["finally_body"], names)
        }
        return
    }
    if kind == "WithStmt" {
        let items = node["items"]
        var i = 0
        while i < items.len() {
            names[items[i]["name"]] = true
            i = i + 1
        }
        collect_block_names(node["body"], names)
        return
    }
    if kind == "ScopeStmt" {
        collect_block_names(node["body"], names)
        return
    }
    if kind == "Block" {
        collect_block_names(node, names)
        return
    }
    if kind == "IfStmt" {
        collect_block_names(node["then_branch"], names)
        if node["else_branch"] != null {
            collect_block_names(node["else_branch"], names)
        }
        return
    }
    if kind == "WhileStmt" {
        collect_block_names(node["body"], names)
        if node["orelse"] != null {
            collect_block_names(node["orelse"], names)
        }
        return
    }
}

fn collect_block_names(node, names) {
    if node["kind"] == "Block" {
        let statements = node["statements"]
        var i = 0
        while i < statements.len() {
            collect_bound_names(statements[i], names)
            i = i + 1
        }
        return
    }
    collect_bound_names(node, names)
}

fn pattern_names(pattern) {
    let kind = pattern["pattern_kind"]
    if kind == "binding" {
        return [pattern["name"]]
    }
    if kind == "list" {
        let names = []
        let items = pattern["items"]
        var i = 0
        while i < items.len() {
            let inner = pattern_names(items[i])
            var j = 0
            while j < inner.len() {
                names.push(inner[j])
                j = j + 1
            }
            i = i + 1
        }
        if pattern["tail"] != null {
            let inner = pattern_names(pattern["tail"])
            var j = 0
            while j < inner.len() {
                names.push(inner[j])
                j = j + 1
            }
        }
        return names
    }
    if kind == "dict" {
        let names = []
        let entries = pattern["entries"]
        var i = 0
        while i < entries.len() {
            let inner = pattern_names(entries[i][1])
            var j = 0
            while j < inner.len() {
                names.push(inner[j])
                j = j + 1
            }
            i = i + 1
        }
        return names
    }
    if kind == "struct" {
        // The fields of a struct are matched by name, the way the
        // entries of a dict are matched.
        let names = []
        let entries = pattern["entries"]
        var i = 0
        while i < entries.len() {
            let inner = pattern_names(entries[i][1])
            var j = 0
            while j < inner.len() {
                names.push(inner[j])
                j = j + 1
            }
            i = i + 1
        }
        return names
    }
    if kind == "or" {
        let names = []
        let items = pattern["items"]
        var i = 0
        while i < items.len() {
            let inner = pattern_names(items[i])
            var j = 0
            while j < inner.len() {
                names.push(inner[j])
                j = j + 1
            }
            i = i + 1
        }
        return names
    }
    if kind == "enum" {
        // The fields of a variant are bound by position, the way the
        // items of a list are bound.
        let names = []
        let items = pattern["items"]
        var i = 0
        while i < items.len() {
            let inner = pattern_names(items[i])
            var j = 0
            while j < inner.len() {
                names.push(inner[j])
                j = j + 1
            }
            i = i + 1
        }
        return names
    }
    return []
}

// Report whether a name is bound somewhere.
fn known_name(state, name) {
    if state["module_names"].has(name) {
        return true
    }
    let stack = state["name_stack"]
    var i = stack.len() - 1
    while i >= 0 {
        if stack[i].has(name) {
            return true
        }
        i = i - 1
    }
    return false
}

// Report a name that is not bound anywhere.
fn check_known_name(state, node) {
    let name = node["name"]
    if BUILTIN_SIGNATURES.has(name) {
        return
    }
    if known_name(state, name) {
        return
    }
    fail("undefined variable '" + name + "'", node)
}

fn check_statements(state, statements, scope) {
    var i = 0
    while i < statements.len() {
        check_statement(state, statements[i], scope)
        i = i + 1
    }
}

// Check a struct: the fields it holds and their types.
fn check_struct(state, node, scope) {
    let seen = {}
    let fields = node["fields"]
    var i = 0
    while i < fields.len() {
        let field = fields[i]
        if seen.has(field["name"]) {
            fail("duplicate field '" + field["name"] + "' on struct '" + node["name"] + "'", field)
        }
        seen[field["name"]] = true
        check_annotation(state, field["type_ann"], field)
        if field["default"] != null {
            check_expr(state, field["default"], scope)
        }
        i = i + 1
    }
    scope[node["name"]] = make_immutable_binding("struct")
}

// Check an enum: the names of its variants and their fields. A variant
// has a type of its own, but the name of the enum is not a value: a
// program writes `Color.Red` and never `Color`, so the name of the enum
// is a type and nothing else.
fn check_enum(state, node, scope) {
    let seen = {}
    let variants = node["variants"]
    var i = 0
    while i < variants.len() {
        let variant = variants[i]
        if seen.has(variant["name"]) {
            fail("duplicate variant '" + variant["name"] + "' on enum '" + node["name"] + "'", variant)
        }
        seen[variant["name"]] = true
        let fields = variant["field_types"]
        var k = 0
        while k < fields.len() {
            check_annotation(state, fields[k], variant)
            k = k + 1
        }
        i = i + 1
    }
    scope[node["name"]] = make_immutable_binding("enum")
}

fn check_pattern(state, pattern) {
    let kind = pattern["pattern_kind"]
    if kind == "struct" {
        if !state["structs"].has(pattern["value"]) {
            fail("unknown struct '" + pattern["value"] + "' in a pattern", pattern)
        }
        let decl = state["structs"][pattern["value"]]
        let fields = decl["fields"]
        let entries = pattern["entries"]
        var i = 0
        while i < entries.len() {
            let field = entries[i][0]
            var has_field = false
            var j = 0
            while j < fields.len() {
                if fields[j]["name"] == field {
                    has_field = true
                }
                j = j + 1
            }
            if !has_field {
                fail("unknown field '" + field + "' on struct '" + pattern["value"] + "' in a pattern", pattern)
            }
            check_pattern(state, entries[i][1])
            i = i + 1
        }
        return
    }
    let items = pattern["items"]
    var i = 0
    while i < items.len() {
        check_pattern(state, items[i])
        i = i + 1
    }
    if pattern["tail"] != null {
        check_pattern(state, pattern["tail"])
    }
    let entries = pattern["entries"]
    var k = 0
    while k < entries.len() {
        check_pattern(state, entries[k][1])
        k = k + 1
    }
}

// Check a protocol: the signatures of its methods.
fn check_protocol(state, node, scope) {
    let seen = {}
    let methods = node["methods"]
    var i = 0
    while i < methods.len() {
        let method = methods[i]
        if seen.has(method["name"]) {
            fail("duplicate method '" + method["name"] + "' on protocol '" + node["name"] + "'", method)
        }
        seen[method["name"]] = true
        check_annotation(state, method["return_type"], method)
        let params = method["params"]
        var k = 0
        while k < params.len() {
            check_annotation(state, params[k]["type_name"], method)
            k = k + 1
        }
        i = i + 1
    }
}

// Check an impl block: the methods of a type.
fn check_impl(state, node, scope) {
    let type_name = node["type_name"]
    if !state["structs"].has(type_name) {
        fail("impl of unknown type '" + type_name + "'", node)
    }
    let struct_decl = state["structs"][type_name]
    let methods = node["methods"]
    var i = 0
    while i < methods.len() {
        let method = methods[i]
        check_annotation(state, method["return_type"], method)
        let local = copy_scope(scope)
        let specs = param_specs(method)
        var k = 0
        while k < specs.len() {
            let spec = specs[k]
            check_annotation(state, spec["type"], method)
            if spec["name"] == "self" {
                local["self"] = make_binding(type_name)
            } else {
                if spec["type"] == null {
                    local[spec["name"]] = make_binding("any")
                } else {
                    local[spec["name"]] = make_binding(spec["type"])
                }
            }
            k = k + 1
        }
        let names = {}
        var j = 0
        while j < specs.len() {
            names[specs[j]["name"]] = true
            j = j + 1
        }
        let bound = bound_names(method["body"]["statements"])
        let keys = bound.keys()
        var b = 0
        while b < keys.len() {
            names[keys[b]] = true
            b = b + 1
        }
        state["name_stack"].push(names)
        state["return_stack"].push(method["return_type"])
        let saved = state["checking_method"]
        state["checking_method"] = [type_name, struct_decl]
        state["function_depth"] = state["function_depth"] + 1
        check_statements(state, method["body"]["statements"], local)
        state["function_depth"] = state["function_depth"] - 1
        state["return_stack"].pop()
        state["name_stack"].pop()
        state["checking_method"] = saved
        i = i + 1
    }
}

// True when the method changes the receiver through `self`.
fn method_mutates(method) {
    return assigns_self_field(method["body"])
}

fn assigns_self_field(node) {
    let kind = node["kind"]
    if kind == "AssignStmt" {
        let target = node["target"]
        if target["kind"] == "Attribute" and target["object"]["kind"] == "Identifier" and target["object"]["name"] == "self" {
            return true
        }
        return false
    }
    if kind == "Block" {
        let statements = node["statements"]
        var i = 0
        while i < statements.len() {
            if assigns_self_field(statements[i]) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if kind == "IfStmt" {
        if assigns_self_field(node["then_branch"]) {
            return true
        }
        if node["else_branch"] != null and assigns_self_field(node["else_branch"]) {
            return true
        }
        return false
    }
    if kind == "WhileStmt" or kind == "ForStmt" {
        if assigns_self_field(node["body"]) {
            return true
        }
        if node["orelse"] != null and assigns_self_field(node["orelse"]) {
            return true
        }
        return false
    }
    return false
}

// The field of a struct with the given name, or null.
fn field_of(struct_decl, name) {
    let fields = struct_decl["fields"]
    var i = 0
    while i < fields.len() {
        if fields[i]["name"] == name {
            return fields[i]
        }
        i = i + 1
    }
    return null
}

// Check the write of a field of a struct.
fn check_field_assign(state, attr, obj_type, node, scope) {
    if obj_type == "any" {
        return
    }
    var struct_decl = null
    if state["structs"].has(obj_type) {
        struct_decl = state["structs"][obj_type]
    }
    if struct_decl == null {
        fail("type '" + obj_type + "' has no fields", attr)
    }
    let field = field_of(struct_decl, attr["name"])
    if field == null {
        fail("unknown field '" + attr["name"] + "' on " + obj_type, attr)
    }
    if !field["mutable"] {
        fail("cannot assign to immutable field '" + attr["name"] + "'", attr)
    }
    if attr["object"]["kind"] == "Identifier" and attr["object"]["name"] != "self" {
        let name = attr["object"]["name"]
        if scope.has(name) {
            let binding = scope[name]
            if !binding["mutable"] {
                fail("cannot assign to field of immutable variable '" + name + "'", attr)
            }
        }
    }
}

// Check the call of a constructor of a struct.
fn constructor_call(state, name, arg_types, node) {
    let struct_decl = state["structs"][name]
    let fields = struct_decl["fields"]
    var required = 0
    var i = 0
    while i < fields.len() {
        if fields[i]["default"] == null {
            required = required + 1
        }
        i = i + 1
    }
    if arg_types.len() < required or arg_types.len() > fields.len() {
        fail("struct '" + name + "' expects " + str(required) + " argument(s), got " + str(arg_types.len()), node)
    }
    var k = 0
    while k < arg_types.len() {
        let field = fields[k]
        if field["type_ann"] != null and !is_assignable(arg_types[k], field["type_ann"]) {
            fail("argument of type '" + arg_types[k] + "' is not assignable to field '" + field["name"] + "' of type '" + field["type_ann"] + "'", node)
        }
        k = k + 1
    }
    return name
}

// Check the call of a method of a struct.
// The variant an attribute expression names, if it names one.
// `Color.Red` is the variant `Red` of the enum `Color`: the name of the
// enum is a type, so the expression is resolved when the program is
// checked and not when it runs.
fn enum_variant_of(state, node) {
    if node["kind"] != "Attribute" {
        return null
    }
    let target = node["object"]
    if target["kind"] != "Identifier" {
        return null
    }
    let variants = state["enums"]
    if !variants.has(target["name"]) {
        return null
    }
    let table = variants[target["name"]]
    if !table.has(node["name"]) {
        fail("enum '" + target["name"] + "' has no variant '" + node["name"] + "'", node)
    }
    return [target["name"], node["name"], table[node["name"]]]
}

// The type of a variant of an enum, and the check of its fields. The
// fields of a variant are bound by position: every field has the type
// the declaration of the variant gives it, and the value of the
// expression is a value of the enum.
fn enum_variant_type(variant, node) {
    let enum_name = variant[0]
    let variant_name = variant[1]
    let fields = variant[2]
    if fields.len() > 0 {
        fail("variant '" + enum_name + "." + variant_name + "' needs " + fields.len() + " field(s), write '" + enum_name + "." + variant_name + "(...)'", node)
    }
    return enum_name
}

fn enum_call(state, node, variant, arg_types) {
    let enum_name = variant[0]
    let variant_name = variant[1]
    let fields = variant[2]
    if arg_types.len() != fields.len() {
        fail("variant '" + enum_name + "." + variant_name + "' expects " + fields.len() + " argument(s), got " + arg_types.len(), node)
    }
    var i = 0
    while i < fields.len() {
        check_assignable(state, arg_types[i], fields[i], node, "argument", enum_name + "." + variant_name)
        i = i + 1
    }
    return enum_name
}

fn method_call(state, node, scope) {
    if node["receiver"]["kind"] == "Identifier" and state["enums"].has(node["receiver"]["name"]) {
        // The fields of a variant are written like the arguments of a
        // method: `Shape.Circle(2.0)` is the variant `Circle` of the
        // enum `Shape` with one field.
        let attr = {"kind": "Attribute", "object": node["receiver"], "name": node["method"], "line": node["line"], "col": node["col"]}
        let variant = enum_variant_of(state, attr)
        if variant != null {
            let args = node["args"]
            let arg_types = []
            var i = 0
            while i < args.len() {
                arg_types.push(check_expr(state, args[i], scope))
                i = i + 1
            }
            return enum_call(state, node, variant, arg_types)
        }
    }
    let recv_type = check_expr(state, node["receiver"], scope)
    let args = node["args"]
    let arg_types = []
    var i = 0
    while i < args.len() {
        arg_types.push(check_expr(state, args[i], scope))
        i = i + 1
    }
    if recv_type == "any" or recv_type == "struct" {
        return "any"
    }
    if state["protocols"].has(recv_type) {
        return protocol_method_call(state, node, recv_type, arg_types)
    }
    let methods = state["impls"]
    if !methods.has(recv_type) {
        if state["structs"].has(recv_type) {
            fail("unknown method '" + node["method"] + "' on " + recv_type, node)
        }
        return "any"
    }
    let table = methods[recv_type]
    if !table.has(node["method"]) {
        if state["structs"].has(recv_type) {
            fail("unknown method '" + node["method"] + "' on " + recv_type, node)
        }
        return "any"
    }
    let method = table[node["method"]]
    if method_mutates(method) {
        let receiver = node["receiver"]
        if receiver["kind"] == "Identifier" and receiver["name"] != "self" {
            let name = receiver["name"]
            if scope.has(name) {
                let binding = scope[name]
                if !binding["mutable"] {
                    fail("cannot call mutating method '" + node["method"] + "' on immutable variable '" + name + "'", node)
                }
            }
        }
    }
    let params = []
    let specs = param_specs(method)
    var k = 0
    while k < specs.len() {
        if specs[k]["name"] != "self" {
            params.push(specs[k])
        }
        k = k + 1
    }
    if arg_types.len() != params.len() {
        fail("method '" + node["method"] + "' expects " + str(params.len()) + " argument(s), got " + str(arg_types.len()), node)
    }
    var p = 0
    while p < arg_types.len() {
        let param = params[p]
        if param["type"] != null {
            check_assignable(state, arg_types[p], param["type"], node, "argument", node["method"])
        }
        p = p + 1
    }
    if method["return_type"] == null {
        return "any"
    }
    return method["return_type"]
}

// Check the call of a method of a protocol. The signature of the
// protocol is the contract of the call: the arity and the types of the
// arguments are the ones it gives.
fn protocol_method_call(state, node, protocol_name, arg_types) {
    let protocol_decl = state["protocols"][protocol_name]
    if !protocol_decl.has(node["method"]) {
        fail("unknown method '" + node["method"] + "' on " + protocol_name, node)
    }
    let signature = protocol_decl[node["method"]]
    let params = []
    let specs = param_specs(signature)
    var k = 0
    while k < specs.len() {
        if specs[k]["name"] != "self" {
            params.push(specs[k])
        }
        k = k + 1
    }
    if arg_types.len() != params.len() {
        fail("method '" + node["method"] + "' expects " + str(params.len()) + " argument(s), got " + str(arg_types.len()), node)
    }
    var p = 0
    while p < arg_types.len() {
        let param = params[p]
        if param["type"] != null {
            check_assignable(state, arg_types[p], param["type"], node, "argument", node["method"])
        }
        p = p + 1
    }
    if signature["return_type"] == null {
        return "any"
    }
    return signature["return_type"]
}

fn check_statement(state, node, scope) {
    let kind = node["kind"]
    if kind == "LetStmt" {
        check_annotation(state, node["type_ann"], node)
        let value_type = check_expr(state, node["value"], scope)
        if node["type_ann"] != null {
            check_assignable(state, value_type, node["type_ann"], node, "variable", node["name"])
        }
        if node["value"]["kind"] == "FnDecl" and (node["type_ann"] == null or node["type_ann"] == "fn") {
            scope[node["name"]] = make_fn_binding(param_specs(node["value"]), node["value"]["return_type"])
        } else {
            if node["type_ann"] == null {
                if state["structs"].has(value_type) {
                    scope[node["name"]] = make_binding(value_type)
                } else {
                    scope[node["name"]] = make_binding("any")
                }
            } else {
                scope[node["name"]] = make_binding(node["type_ann"])
            }
        }
        if !node["mutable"] {
            scope[node["name"]]["mutable"] = false
        }
        return
    }
    if kind == "StructDecl" {
        check_struct(state, node, scope)
        return
    }
    if kind == "EnumDecl" {
        check_enum(state, node, scope)
        return
    }
    if kind == "ImplDecl" {
        check_impl(state, node, scope)
        return
    }
    if kind == "ProtocolDecl" {
        check_protocol(state, node, scope)
        return
    }
    if kind == "FnDecl" {
        push_type_vars(state, node)
        check_annotation(state, node["return_type"], node)
        check_decorators(state, node, scope)
        check_function(state, node, scope)
        pop_type_vars(state)
        // The name of the function belongs to the block that holds it, so a
        // function that is defined inside a block may be called there.
        let binding = make_immutable_fn_binding(param_specs(node), node["return_type"])
        binding["type_params"] = node["type_params"]
        scope[node["name"]] = binding
        return
    }
    if kind == "AssignStmt" {
        let value_type = check_expr(state, node["value"], scope)
        if node["target"]["kind"] == "Identifier" {
            let name = node["target"]["name"]
            if scope.has(name) {
                let binding = scope[name]
                if binding["type"] != "any" {
                    check_assignable(state, value_type, binding["type"], node, "variable", name)
                }
                if !binding["mutable"] {
                    fail("cannot assign to immutable variable '" + name + "'", node)
                }
            }
        } else {
            if node["target"]["kind"] == "UnpackTarget" {
                let leaves = plan_leaves(node["target"]["targets"])
                var i = 0
                while i < leaves.len() {
                    let leaf = leaves[i]
                    if leaf["kind"] == "Identifier" {
                        let name = leaf["name"]
                        if scope.has(name) {
                            let binding = scope[name]
                            if binding["type"] != "any" {
                                check_assignable(state, value_type, binding["type"], node, "variable", name)
                            }
                            if !binding["mutable"] {
                                fail("cannot assign to immutable variable '" + name + "'", node)
                            }
                        }
                    }
                    i = i + 1
                }
            } else {
                if node["target"]["kind"] == "Attribute" {
                    let attr = node["target"]
                    let obj_type = check_expr(state, attr["object"], scope)
                    check_field_assign(state, attr, obj_type, node, scope)
                } else {
                    check_expr(state, node["target"], scope)
                }
            }
        }
        return
    }
    if kind == "UnpackStmt" {
        check_expr(state, node["value"], scope)
        let names = unpack_names(node["targets"])
        var i = 0
        while i < names.len() {
            scope[names[i]] = make_binding("any")
            if !node["mutable"] {
                scope[names[i]]["mutable"] = false
            }
            i = i + 1
        }
        return
    }
    if kind == "ReturnStmt" {
        var value_type = "null"
        if node["value"] != null {
            value_type = check_expr(state, node["value"], scope)
        }
        let stack = state["return_stack"]
        if stack.len() > 0 {
            let declared = stack[stack.len() - 1]
            if declared != null {
                check_assignable(state, value_type, declared, node, "return", "")
            }
        }
        return
    }
    if kind == "Block" {
        check_statements(state, node["statements"], copy_scope(scope))
        return
    }
    if kind == "IfStmt" {
        check_expr(state, node["condition"], scope)
        check_statement(state, node["then_branch"], copy_scope(scope))
        if node["else_branch"] != null {
            check_statement(state, node["else_branch"], copy_scope(scope))
        }
        return
    }
    if kind == "WhileStmt" {
        check_expr(state, node["condition"], scope)
        state["loop_depth"] = state["loop_depth"] + 1
        check_statements(state, node["body"]["statements"], copy_scope(scope))
        if node["orelse"] != null {
            check_statement(state, node["orelse"], copy_scope(scope))
        }
        state["loop_depth"] = state["loop_depth"] - 1
        return
    }
    if kind == "ForStmt" {
        let item_type = check_expr(state, node["iterable"], scope)
        let walked = base_type(item_type)
        if walked == "result" or walked == "option" {
            fail("'" + walked + "' is not walked by a 'for'", node)
        }
        let element = element_type(item_type)
        let loop_scope = copy_scope(scope)
        let targets = node["targets"]
        var i = 0
        while i < targets.len() {
            if element == null {
                loop_scope[targets[i]] = make_binding("any")
            } else {
                loop_scope[targets[i]] = make_binding(element)
            }
            i = i + 1
        }
        state["loop_depth"] = state["loop_depth"] + 1
        check_statements(state, node["body"]["statements"], loop_scope)
        if node["orelse"] != null {
            // The else runs after the loop, so the name of the loop is
            // gone by then.
            check_statement(state, node["orelse"], copy_scope(scope))
        }
        state["loop_depth"] = state["loop_depth"] - 1
        return
    }
    if kind == "AssertStmt" {
        check_expr(state, node["condition"], scope)
        if node["message"] != null {
            check_expr(state, node["message"], scope)
        }
        return
    }
    if kind == "ExprStmt" {
        check_expr(state, node["expr"], scope)
        return
    }
    if kind == "DelStmt" {
        check_expr(state, node["target"], scope)
        return
    }
    if kind == "YieldStmt" {
        if state["function_depth"] == 0 {
            fail("'yield' outside of a function", node)
        }
        if node["value"] != null {
            check_expr(state, node["value"], scope)
        }
        return
    }
    if kind == "YieldExpr" {
        if state["function_depth"] == 0 {
            fail("'yield' outside of a function", node)
        }
        if node["value"] != null {
            check_expr(state, node["value"], scope)
        }
        return
    }
    if kind == "Program" {
        check_statements(state, node["statements"], copy_scope(scope))
        return
    }
    if kind == "ImportStmt" {
        check_import(state, node, scope)
        return
    }
    if kind == "TryStmt" {
        let catch_scope = copy_scope(scope)
        var i = 0
        while i < node["catch_params"].len() {
            catch_scope[node["catch_params"][i]] = make_binding("any")
            i = i + 1
        }
        check_statement(state, node["try_block"], copy_scope(scope))
        if node["catch_block"] != null {
            check_statement(state, node["catch_block"], catch_scope)
        }
        if node["finally_body"] != null {
            check_statement(state, node["finally_body"], copy_scope(scope))
        }
        return
    }
    if kind == "WithStmt" {
        let with_scope = copy_scope(scope)
        let items = node["items"]
        var i = 0
        while i < items.len() {
            check_expr(state, items[i]["expr"], with_scope)
            with_scope[items[i]["name"]] = make_binding("any")
            i = i + 1
        }
        check_statement(state, node["body"], with_scope)
        return
    }
    if kind == "ScopeStmt" {
        check_statement(state, node["body"], copy_scope(scope))
        return
    }
    if kind == "ThrowStmt" {
        check_expr(state, node["value"], scope)
        if node["cause"] != null {
            check_expr(state, node["cause"], scope)
        }
        return
    }
    if kind == "MatchStmt" {
        check_expr(state, node["subject"], scope)
        let cases = node["cases"]
        var i = 0
        while i < cases.len() {
            check_pattern(state, cases[i][0])
            let case_scope = copy_scope(scope)
            let names = pattern_names(cases[i][0])
            var j = 0
            while j < names.len() {
                case_scope[names[j]] = make_binding("any")
                j = j + 1
            }
            let guard = cases[i][0]["guard"]
            if guard != null {
                check_expr(state, guard, case_scope)
            }
            check_statement(state, cases[i][1], case_scope)
            i = i + 1
        }
        return
    }
    if kind == "BreakStmt" {
        if state["loop_depth"] == 0 {
            fail("'break' outside of a loop", node)
        }
        return
    }
    if kind == "ContinueStmt" {
        if state["loop_depth"] == 0 {
            fail("'continue' outside of a loop", node)
        }
        return
    }
    fail("cannot check statement: " + kind, node)
}

// Check that every decorator of a function is a known function. A
// decorator is written as a name, so the name must be bound in the scope
// that holds the function, and it must be a function. The name of an
// import that is not checked yet is accepted, so that the order of the
// statements does not decide the meaning.
fn check_decorators(state, node, scope) {
    let decorators = node["decorators"]
    if decorators == null {
        return
    }
    var i = 0
    while i < decorators.len() {
        let name = decorators[i]["name"]
        if !scope.has(name) {
            if known_name(state, name) or BUILTIN_SIGNATURES.has(name) {
                i = i + 1
                continue
            }
            fail("undefined decorator '" + name + "'", decorators[i])
        }
        let binding = scope[name]
        if binding["type"] != "fn" and binding["type"] != "any" {
            fail("decorator '" + name + "' is not a function", decorators[i])
        }
        i = i + 1
    }
}

fn check_function(state, decl, scope) {
    let local = copy_scope(scope)
    let specs = param_specs(decl)
    let names = {}
    var i = 0
    while i < specs.len() {
        let spec = specs[i]
        check_annotation(state, spec["type"], decl)
        if spec["type"] == null {
            local[spec["name"]] = make_binding("any")
        } else {
            local[spec["name"]] = make_binding(spec["type"])
        }
        names[spec["name"]] = true
        i = i + 1
    }
    let bound = bound_names(decl["body"]["statements"])
    let keys = bound.keys()
    var k = 0
    while k < keys.len() {
        names[keys[k]] = true
        k = k + 1
    }
    state["name_stack"].push(names)
    state["return_stack"].push(decl["return_type"])
    let saved_loop_depth = state["loop_depth"]
    state["loop_depth"] = 0
    state["function_depth"] = state["function_depth"] + 1
    check_statements(state, decl["body"]["statements"], local)
    state["function_depth"] = state["function_depth"] - 1
    state["loop_depth"] = saved_loop_depth
    state["return_stack"].pop()
    state["name_stack"].pop()
}

// Check a comprehension in its own scope. The loop targets are fresh
// mutable bindings, so they never leak into the enclosing scope.
fn check_comprehension(state, node, scope) {
    let local = copy_scope(scope)
    let clauses = node["clauses"]
    var i = 0
    while i < clauses.len() {
        let item_type = check_expr(state, clauses[i]["iterable"], local)
        let walked = base_type(item_type)
        if walked == "result" or walked == "option" {
            fail("'" + walked + "' is not walked by a 'for'", node)
        }
        local[clauses[i]["target"]] = make_binding("any")
        i = i + 1
    }
    i = 0
    while i < clauses.len() {
        if clauses[i]["condition"] != null {
            check_expr(state, clauses[i]["condition"], local)
        }
        i = i + 1
    }
    if node["is_dict"] {
        check_expr(state, node["key"], local)
        check_expr(state, node["value"], local)
        return "dict"
    }
    check_expr(state, node["element"], local)
    return "list"
}

fn check_expr(state, node, scope) {
    if node["kind"] == "YieldExpr" {
        if state["function_depth"] == 0 {
            fail("'yield' outside of a function", node)
        }
        if node["value"] != null {
            check_expr(state, node["value"], scope)
        }
        return
    }
    let kind = node["kind"]
    if kind == "Literal" {
        return type_of(node["value"])
    }
    if kind == "Identifier" {
        let name = node["name"]
        if scope.has(name) {
            if scope[name]["type"] == "enum" {
                fail("enum '" + name + "' is not a value", node)
            }
            return scope[name]["type"]
        }
        if state["protocols"].has(name) {
            fail("protocol '" + name + "' is not a value", node)
        }
        if state["enums"].has(name) {
            fail("enum '" + name + "' is not a value", node)
        }
        if BUILTIN_SIGNATURES.has(name) {
            return "fn"
        }
        check_known_name(state, node)
        return "any"
    }
    if kind == "ListLiteral" {
        var i = 0
        while i < node["elements"].len() {
            check_expr(state, node["elements"][i], scope)
            i = i + 1
        }
        return "list"
    }
    if kind == "DictLiteral" {
        var i = 0
        while i < node["entries"].len() {
            check_expr(state, node["entries"][i][0], scope)
            check_expr(state, node["entries"][i][1], scope)
            i = i + 1
        }
        return "dict"
    }
    if kind == "FString" {
        let parts = node["parts"]
        var i = 0
        while i < parts.len() {
            let part = parts[i]
            if part["literal"] == null {
                check_expr(state, part["expr"], scope)
            }
            i = i + 1
        }
        return "string"
    }
    if kind == "Comprehension" {
        return check_comprehension(state, node, scope)
    }
    if kind == "FnDecl" {
        let specs = param_specs(node)
        var i = 0
        while i < specs.len() {
            check_annotation(state, specs[i]["type"], node)
            i = i + 1
        }
        check_annotation(state, node["return_type"], node)
        check_function(state, node, scope)
        return "fn"
    }
    if kind == "Call" {
        return check_call(state, node, scope)
    }
    if kind == "Unary" {
        check_expr(state, node["operand"], scope)
        return "any"
    }
    if kind == "Binary" {
        check_expr(state, node["left"], scope)
        check_expr(state, node["right"], scope)
        return "any"
    }
    if kind == "Logical" {
        check_expr(state, node["left"], scope)
        check_expr(state, node["right"], scope)
        return "any"
    }
    if kind == "Index" {
        let target_type = check_expr(state, node["target"], scope)
        if node["index"]["kind"] == "Slice" {
            let slice = node["index"]
            let parts = [slice["start"], slice["stop"], slice["step"]]
            var i = 0
            while i < parts.len() {
                if parts[i] != null {
                    check_expr(state, parts[i], scope)
                }
                i = i + 1
            }
            return target_type
        }
        check_expr(state, node["index"], scope)
        let element = element_type(target_type)
        if element == null {
            return "any"
        }
        return element
    }
    if kind == "MethodCall" {
        return method_call(state, node, scope)
    }
    if kind == "Attribute" {
        let variant = enum_variant_of(state, node)
        if variant != null {
            return enum_variant_type(variant, node)
        }
        let obj_type = check_expr(state, node["object"], scope)
        if obj_type == "any" or obj_type == "struct" {
            return "any"
        }
        var struct_decl = null
        if state["structs"].has(obj_type) {
            struct_decl = state["structs"][obj_type]
        }
        if struct_decl == null {
            fail("type '" + obj_type + "' has no fields", node)
        }
        let field = field_of(struct_decl, node["name"])
        if field == null {
            fail("unknown field '" + node["name"] + "' on " + obj_type, node)
        }
        if field["type_ann"] == null {
            return "any"
        }
        return field["type_ann"]
    }
    if kind == "Unwrap" {
        return check_unwrap(state, node, scope)
    }
    fail("cannot check expression: " + kind, node)
    return "any"
}

fn check_unwrap(state, node, scope) {
    if state["function_depth"] == 0 {
        fail("the '?' operator is only allowed inside a function", node)
    }
    let source = check_expr(state, node["expr"], scope)
    if source != "result" and source != "option" and source != "any" and source != "dict" {
        fail("cannot use '?' on a value of type '" + source + "'", node)
    }
    let stack = state["return_stack"]
    if stack.len() > 0 {
        let declared = stack[stack.len() - 1]
        if declared == null or declared == "any" {
            return "any"
        }
        if source != "any" and source != "dict" and declared != source {
            fail("the '?' operator needs a function that returns '" + source + "'", node)
        }
    }
    return "any"
}

fn check_call(state, node, scope) {
    let args = node["args"]
    let arg_types = []
    var i = 0
    while i < args.len() {
        arg_types.push(check_expr(state, args[i], scope))
        i = i + 1
    }
    let kwarg_types = {}
    let kwargs = node["kwargs"]
    var k = 0
    while k < kwargs.len() {
        let entry = kwargs[k]
        kwarg_types[entry[0]] = check_expr(state, entry[1], scope)
        k = k + 1
    }
    if node["callee"]["kind"] != "Identifier" {
        check_expr(state, node["callee"], scope)
        return "any"
    }
    let name = node["callee"]["name"]
    if !scope.has(name) {
        if BUILTIN_SIGNATURES.has(name) {
            return check_builtin_call(name, node, arg_types)
        }
        check_known_name(state, node["callee"])
        return "any"
    }
    let binding = scope[name]
    if binding["type"] == "any" {
        return "any"
    }
    if binding["type"] == "struct" {
        return constructor_call(state, name, arg_types, node)
    }
    if binding["type"] != "fn" {
        fail("'" + name + "' of type '" + binding["type"] + "' is not callable", node)
    }
    if binding["params"] == null {
        return "any"
    }
    if binding["type_params"] != null and binding["type_params"].len() > 0 {
        return generic_call(state, name, binding, node, arg_types, kwarg_types, scope)
    }
    check_call_args(state, name, binding["params"], arg_types, kwarg_types, node)
    if binding["return_type"] == null {
        return "any"
    }
    return binding["return_type"]
}

// The type arguments of a type are written with a comma and a space
// between them.
fn join_types(args) {
    var out = ""
    var i = 0
    while i < args.len() {
        if i > 0 {
            out = out + ", "
        }
        out = out + args[i]
        i = i + 1
    }
    return out
}

fn check_call_args(state, name, specs, arg_types, kwarg_types, node) {
    let positional = []
    let kwonly = []
    var has_vararg = false
    var has_kwarg = false
    var plain = true
    var i = 0
    while i < specs.len() {
        let spec = specs[i]
        if spec["param_kind"] == "positional" {
            positional.push(spec)
        } else {
            if spec["param_kind"] == "kwonly" {
                kwonly.push(spec)
                plain = false
            } else {
                if spec["param_kind"] == "vararg" {
                    has_vararg = true
                    plain = false
                } else {
                    has_kwarg = true
                    plain = false
                }
            }
        }
        if spec["has_default"] {
            plain = false
        }
        i = i + 1
    }
    if plain and kwarg_types.len() == 0 {
        if arg_types.len() != specs.len() {
            fail("function '" + name + "' expects " + str(specs.len()) + " argument(s), got " + str(arg_types.len()), node)
        }
        var j = 0
        while j < specs.len() {
            check_arg_type(state, arg_types[j], specs[j]["type"], name, node)
            j = j + 1
        }
        return
    }
    let known = {}
    i = 0
    while i < positional.len() {
        known[positional[i]["name"]] = positional[i]
        i = i + 1
    }
    i = 0
    while i < kwonly.len() {
        known[kwonly[i]["name"]] = kwonly[i]
        i = i + 1
    }
    if arg_types.len() > positional.len() and !has_vararg {
        fail("function '" + name + "' expects " + str(positional.len()) + " argument(s), got " + str(arg_types.len()), node)
    }
    var p = 0
    while p < arg_types.len() and p < positional.len() {
        check_arg_type(state, arg_types[p], positional[p]["type"], name, node)
        p = p + 1
    }
    let keys = kwarg_types.keys()
    i = 0
    while i < keys.len() {
        let key = keys[i]
        if !known.has(key) {
            if !has_kwarg {
                fail("function '" + name + "' got an unexpected keyword argument '" + key + "'", node)
            }
        } else {
            check_arg_type(state, kwarg_types[key], known[key]["type"], name, node)
        }
        i = i + 1
    }
    i = 0
    while i < positional.len() {
        let spec = positional[i]
        if i < arg_types.len() and kwarg_types.has(spec["name"]) {
            fail("function '" + name + "' got multiple values for argument '" + spec["name"] + "'", node)
        }
        i = i + 1
    }
    i = 0
    while i < positional.len() {
        let spec = positional[i]
        if i < arg_types.len() {
            i = i + 1
            continue
        }
        if kwarg_types.has(spec["name"]) {
            i = i + 1
            continue
        }
        if spec["has_default"] {
            i = i + 1
            continue
        }
        fail("function '" + name + "' missing required argument '" + spec["name"] + "'", node)
    }
    i = 0
    while i < kwonly.len() {
        let spec = kwonly[i]
        if !kwarg_types.has(spec["name"]) and !spec["has_default"] {
            fail("function '" + name + "' missing required argument '" + spec["name"] + "'", node)
        }
        i = i + 1
    }
}

fn check_arg_type(state, arg_type, ptype, name, node) {
    if ptype == null {
        return
    }
    check_assignable(state, arg_type, ptype, node, "argument", name)
}

fn check_builtin_call(name, node, arg_types) {
    let sigs = BUILTIN_SIGNATURES[name]
    var i = 0
    while i < sigs.len() {
        let params = sigs[i][0]
        let return_type = sigs[i][1]
        var matched = true
        if params.len() != arg_types.len() {
            matched = false
        } else {
            var j = 0
            while j < params.len() {
                if !is_assignable(arg_types[j], params[j]) {
                    matched = false
                }
                j = j + 1
            }
        }
        if matched {
            return return_type
        }
        i = i + 1
    }
    let counts = []
    var k = 0
    while k < sigs.len() {
        counts.push(str(sigs[k][0].len()))
        k = k + 1
    }
    fail(name + "() received arguments that do not match its signature (expected " + counts.join(" or ") + " argument(s))", node)
    return "any"
}

fn dirname(path) {
    var i = path.len() - 1
    while i >= 0 {
        if path[i] == "/" {
            if i == 0 {
                return "/"
            }
            return path.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

fn module_error_message(path, message) {
    let prefix = "cannot load module '" + path + "'"
    if message.starts_with(prefix) {
        return message
    }
    return prefix + ": " + message
}

fn exported_binding(state, statement) {
    if statement["kind"] == "FnDecl" and statement["exported"] {
        check_annotation_throw(state, statement["return_type"])
        let ptypes = param_specs(statement)
        var i = 0
        while i < ptypes.len() {
            check_annotation_throw(state, ptypes[i]["type"])
            i = i + 1
        }
        return [statement["name"], make_immutable_fn_binding(param_specs(statement), statement["return_type"])]
    }
    if statement["kind"] == "LetStmt" and statement["exported"] {
        check_annotation_throw(state, statement["type_ann"])
        if statement["type_ann"] == null {
            return [statement["name"], make_binding("any")]
        }
        return [statement["name"], make_binding(statement["type_ann"])]
    }
    return null
}

fn module_exports(state, path, node) {
    var full_path = null
    try {
        full_path = module_path(path, state["base_dir"])
    } catch err {
        fail(module_error_message(path, err), node)
    }
    if state["module_cache"].has(full_path) {
        return state["module_cache"][full_path]
    }
    if state["module_loading"].has(full_path) {
        fail("circular import of '" + path + "'", node)
    }
    var source = null
    try {
        source = read_module(path, full_path)
    } catch err {
        fail(module_error_message(path, err), node)
    }
    var program = null
    try {
        program = parse(tokenize(source))
    } catch err {
        fail(module_error_message(path, err), node)
    }
    state["module_loading"][full_path] = true
    let exports = {}
    let previous_dir = state["base_dir"]
    state["base_dir"] = dirname(full_path)
    var i = 0
    while i < program["statements"].len() {
        let statement = program["statements"][i]
        if statement["kind"] == "ImportStmt" {
            check_import(state, statement, {})
        }
        var binding = null
        try {
            binding = exported_binding(state, statement)
        } catch err {
            fail(module_error_message(path, err), node)
        }
        if binding != null {
            exports[binding[0]] = binding[1]
        }
        i = i + 1
    }
    state["base_dir"] = previous_dir
    state["module_loading"].remove(full_path)
    state["module_cache"][full_path] = exports
    return exports
}

fn check_import(state, node, scope) {
    let exports = module_exports(state, node["path"], node)
    var i = 0
    while i < node["names"].len() {
        let name = node["names"][i]
        if !exports.has(name) {
            fail("module '" + node["path"] + "' does not export '" + name + "'", node)
        }
        scope[name] = exports[name]
        scope[name]["mutable"] = false
        i = i + 1
    }
}

export fn check_program(program, base_dir) {
    let state = make_state(base_dir)
    let scope = {}
    collect_functions(program["statements"], scope)
    collect_structs(state, program["statements"], scope)
    collect_enums(state, program["statements"])
    collect_protocols(state, program["statements"])
    collect_module_names(state, program["statements"])
    check_statements(state, program["statements"], scope)
    return null
}

fn unpack_names(targets) {
    let names = []
    var i = 0
    while i < targets.len() {
        collect_unpack_names(targets[i], names)
        i = i + 1
    }
    return names
}

fn collect_unpack_names(target, names) {
    if target["kind"] == "UnpackTarget" {
        if target["target_kind"] == "star" {
            names.push(target["name"])
            return
        }
        let targets = target["targets"]
        var i = 0
        while i < targets.len() {
            collect_unpack_names(targets[i], names)
            i = i + 1
        }
        return
    }
    names.push(target["name"])
}

fn plan_leaves(targets) {
    let leaves = []
    var i = 0
    while i < targets.len() {
        collect_plan_leaves(targets[i], leaves)
        i = i + 1
    }
    return leaves
}

fn collect_plan_leaves(target, leaves) {
    if target["kind"] == "UnpackTarget" {
        if target["target_kind"] == "star" {
            leaves.push(target)
            return
        }
        let targets = target["targets"]
        var i = 0
        while i < targets.len() {
            collect_plan_leaves(targets[i], leaves)
            i = i + 1
        }
        return
    }
    leaves.push(target)
}
