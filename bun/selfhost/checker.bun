import { tokenize } from "./lexer"
import { parse } from "./parser"

let TYPES = {
    "int": true,
    "float": true,
    "string": true,
    "bool": true,
    "null": true,
    "any": true,
    "list": true,
    "dict": true,
    "fn": true,
    "secret": true,
    "set": true,
    "number": true,
    "text": true,
}

// The names that are another name: a `number` is a `float` and a `text`
// is a `string`.
let ALIASES = {
    "number": "float",
    "text": "string",
}

