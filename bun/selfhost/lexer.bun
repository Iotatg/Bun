let KEYWORDS = {
    "let": "LET",
    "var": "VAR",
    "fn": "FN",
    "if": "IF",
    "else": "ELSE",
    "while": "WHILE",
    "for": "FOR",
    "in": "IN",
    "return": "RETURN",
    "true": "TRUE",
    "false": "FALSE",
    "null": "NULL",
    "and": "AND",
    "or": "OR",
    "not": "NOT",
    "import": "IMPORT",
    "from": "FROM",
    "export": "EXPORT",
    "try": "TRY",
    "catch": "CATCH",
    "finally": "FINALLY",
    "with": "WITH",
    "as": "AS",
    "throw": "THROW",
    "assert": "ASSERT",
    "break": "BREAK",
    "continue": "CONTINUE",
    "del": "DEL",
    "yield": "YIELD",
    "struct": "STRUCT",
    "enum": "ENUM",
    "impl": "IMPL",
    "protocol": "PROTOCOL",
}

let THREE_CHAR = {
    "<<=": "LSHIFT_ASSIGN",
    ">>=": "RSHIFT_ASSIGN",
}

let TWO_CHAR = {
    "==": "EQ",
    "!=": "NEQ",
    "<=": "LTE",
    ">=": "GTE",
    "->": "ARROW",
    "=>": "FAT_ARROW",
    "**": "DOUBLE_STAR",
    "<<": "LSHIFT",
    ">>": "RSHIFT",
    "++": "INCREMENT",
    "--": "DECREMENT",
    "??": "NULL_COALESCE",
    "+=": "PLUS_ASSIGN",
    "-=": "MINUS_ASSIGN",
    "*=": "STAR_ASSIGN",
    "/=": "SLASH_ASSIGN",
    "%=": "PERCENT_ASSIGN",
    "&=": "AMP_ASSIGN",
    "|=": "PIPE_ASSIGN",
    "^=": "CARET_ASSIGN",
}

let ONE_CHAR = {
    "+": "PLUS",
    "-": "MINUS",
    "*": "STAR",
    "/": "SLASH",
    "%": "PERCENT",
    "&": "AMP",
    "|": "PIPE",
    "^": "CARET",
    "~": "TILDE",
    "=": "ASSIGN",
    "<": "LT",
    ">": "GT",
    "!": "BANG",
    "?": "QUESTION",
    "(": "LPAREN",
    ")": "RPAREN",
    "{": "LBRACE",
    "}": "RBRACE",
    "[": "LBRACKET",
    "]": "RBRACKET",
    ",": "COMMA",
    ":": "COLON",
    ".": "DOT",
    "@": "AT",
}

let ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f", "v": "\v", "0": "\0", "\"": "\"", "'": "'", "\\": "\\"}

// \xHH, \uHHHH and \UHHHHHHHH name a code point by its hexadecimal value.
fn hex_value(ch) -> int {
    let i = index_of("0123456789abcdef", lower(ch))
    if i == -1 {
        throw "invalid hex digit '" + ch + "'"
    }
    return i
}

fn unicode_escape(st, count) -> string {
    var value = 0
    var i = 0
    while i < count {
        if st["pos"] >= st["source"].len() {
            throw "incomplete unicode escape"
        }
        let ch = advance(st)
        value = value * 16 + hex_value(ch)
        i = i + 1
    }
    return chr(value)
}

fn is_digit(ch) {
    return ch >= "0" and ch <= "9"
}

fn is_lower(ch) {
    return ch >= "a" and ch <= "z"
}

fn is_upper(ch) {
    return ch >= "A" and ch <= "Z"
}

fn is_alpha(ch) {
    if ch.len() == 0 {
        return false
    }
    if is_lower(ch) or is_upper(ch) {
        return true
    }
    // Anything outside ASCII is a letter as far as the language is
    // concerned: Devanagari, Han, Arabic, Cyrillic, and the combining
    // marks that a script such as Devanagari writes between letters.
    // Bun accepts a name in any script, so the front-end must too.
    return ord(ch) >= 128
}

fn is_alnum(ch) {
    return is_alpha(ch) or is_digit(ch)
}

// True when the current position starts an exponent, like `e-8`.
fn exponent_ahead(st) {
    let ch = peek_at(st, 0)
    if ch != "e" and ch != "E" {
        return false
    }
    var offset = 1
    let sign = peek_at(st, offset)
    if sign == "+" or sign == "-" {
        offset = offset + 1
    }
    return is_digit(peek_at(st, offset))
}

fn make_lexer(source, lang) {
    return {"source": source, "pos": 0, "line": 1, "col": 1,
            "tokens": [], "lang": lang}
}

fn peek_at(st, offset) {
    let index = st["pos"] + offset
    if index < st["source"].len() {
        return st["source"][index]
    }
    return ""
}

fn advance(st) {
    let ch = st["source"][st["pos"]]
    st["pos"] = st["pos"] + 1
    if ch == "\n" {
        st["line"] = st["line"] + 1
        st["col"] = 1
    } else {
        st["col"] = st["col"] + 1
    }
    return ch
}

fn add_token(st, token_type, value, line, col) {
    st["tokens"].push({"type": token_type, "value": value, "line": line, "col": col})
}

fn number(st) {
    let line = st["line"]
    let col = st["col"]
    let start = st["pos"]
    if peek_at(st, 0) == "0" {
        let marker = peek_at(st, 1)
        if marker == "x" or marker == "X" or marker == "b" or marker == "B" or marker == "o" or marker == "O" {
            advance(st)
            advance(st)
            let digits_start = st["pos"]
            while is_alnum(peek_at(st, 0)) {
                advance(st)
            }
            let digits = st["source"].slice(digits_start, st["pos"])
            if digits.len() == 0 {
                throw "invalid numeric literal at " + str(line) + ":" + str(col)
            }
            var base = 16
            if marker == "b" or marker == "B" {
                base = 2
            }
            if marker == "o" or marker == "O" {
                base = 8
            }
            add_token(st, "INT", int_literal(digits, base, line, col), line, col)
            return
        }
    }
    while is_digit(peek_at(st, 0)) {
        advance(st)
    }
    var is_float = false
    if peek_at(st, 0) == "." and is_digit(peek_at(st, 1)) {
        is_float = true
        advance(st)
        while is_digit(peek_at(st, 0)) {
            advance(st)
        }
    }
    if exponent_ahead(st) {
        is_float = true
        advance(st)
        if peek_at(st, 0) == "+" or peek_at(st, 0) == "-" {
            advance(st)
        }
        while is_digit(peek_at(st, 0)) {
            advance(st)
        }
    } else if peek_at(st, 0) == "e" or peek_at(st, 0) == "E" {
        throw "invalid numeric literal at " + str(line) + ":" + str(col)
    }
    let text = st["source"].slice(start, st["pos"])
    if is_float {
        add_token(st, "FLOAT", float(text), line, col)
    } else {
        add_token(st, "INT", int_literal(text, 10, line, col), line, col)
    }
}

// Read an integer literal. The integers of the language are 64 bits
// wide, so a literal that does not fit is an error and not a number.
fn int_literal(text, base, line, col) {
    try {
        return int(text, base)
    } catch err {
        throw "integer literal out of range at " + str(line) + ":" + str(col)
    }
}

fn string_token(st, quote) {
    let line = st["line"]
    let col = st["col"]
    advance(st)
    let chars = []
    var done = false
    while !done {
        if st["pos"] >= st["source"].len() {
            throw "unterminated string at " + str(line) + ":" + str(col)
        }
        let ch = advance(st)
        if ch == quote {
            done = true
        } else {
            if ch == "\\" {
                let esc_line = st["line"]
                let esc_col = st["col"]
                let nxt = advance(st)
                if nxt == "x" {
                    chars.push(unicode_escape(st, 2))
                } else if nxt == "u" {
                    chars.push(unicode_escape(st, 4))
                } else if nxt == "U" {
                    chars.push(unicode_escape(st, 8))
                } else if !ESCAPES.has(nxt) {
                    throw "invalid escape at " + str(esc_line) + ":" + str(esc_col)
                } else {
                    chars.push(ESCAPES.get(nxt))
                }
            } else {
                chars.push(ch)
            }
        }
    }
    add_token(st, "STRING", chars.join(""), line, col)
}

// A multiline string delimited by three matching quotes.  Newlines and
// single quotes inside the body are ordinary characters; only three
// quotes in a row close it.  Escapes use the same helpers as a normal
// string, so the two front ends cannot disagree about a literal.
fn triple_string_token(st, quote) {
    let line = st["line"]
    let col = st["col"]
    advance(st)
    advance(st)
    advance(st)
    let chars = []
    while true {
        if st["pos"] >= st["source"].len() {
            throw "unterminated multiline string at " + str(line) + ":" + str(col)
        }
        if peek_at(st, 0) == quote and peek_at(st, 1) == quote and peek_at(st, 2) == quote {
            advance(st)
            advance(st)
            advance(st)
            break
        }
        let ch = advance(st)
        if ch == "\\" {
            let esc_line = st["line"]
            let esc_col = st["col"]
            let nxt = advance(st)
            if nxt == "x" {
                chars.push(unicode_escape(st, 2))
            } else if nxt == "u" {
                chars.push(unicode_escape(st, 4))
            } else if nxt == "U" {
                chars.push(unicode_escape(st, 8))
            } else if !ESCAPES.has(nxt) {
                throw "invalid escape at " + str(esc_line) + ":" + str(esc_col)
            } else {
                chars.push(ESCAPES.get(nxt))
            }
        } else {
            chars.push(ch)
        }
    }
    add_token(st, "STRING", chars.join(""), line, col)
}

// Skip a nested string literal that appears inside an interpolated
// f-string expression.
fn skip_nested_string(st, quote, line, col) {
    var closed = false
    while !closed {
        if st["pos"] >= st["source"].len() {
            throw "unterminated string at " + str(line) + ":" + str(col)
        }
        let inner = peek_at(st, 0)
        if inner == "\\" {
            advance(st)
            if st["pos"] >= st["source"].len() {
                throw "unterminated string at " + str(line) + ":" + str(col)
            }
            advance(st)
        } else {
            advance(st)
            if inner == quote {
                closed = true
            }
        }
    }
}

// An f-string token carries the raw body between the quotes. Escapes are
// resolved by the parser, which needs the literal text and the
// interpolated expressions separately.
fn fstring_token(st) {
    let line = st["line"]
    let col = st["col"]
    advance(st)
    let quote = advance(st)
    let start = st["pos"]
    var depth = 0
    var scanning = true
    while scanning {
        if st["pos"] >= st["source"].len() {
            throw "unterminated string at " + str(line) + ":" + str(col)
        }
        let ch = peek_at(st, 0)
        if ch == "\\" {
            advance(st)
            if st["pos"] >= st["source"].len() {
                throw "unterminated string at " + str(line) + ":" + str(col)
            }
            advance(st)
        } else {
            if depth == 0 and ch == quote {
                scanning = false
            } else {
                if ch == "{" {
                    depth = depth + 1
                    advance(st)
                } else {
                    if ch == "}" {
                        if depth > 0 {
                            depth = depth - 1
                        }
                        advance(st)
                    } else {
                        if ch == quote {
                            advance(st)
                            skip_nested_string(st, quote, line, col)
                        } else {
                            advance(st)
                        }
                    }
                }
            }
        }
    }
    let body = st["source"].slice(start, st["pos"])
    advance(st)
    add_token(st, "FSTRING", body, line, col)
}

// A localized keyword in a script that writes words without spaces may
// be glued to the name after it. These are the same code point ranges the
// Python front end uses, in decimal because Bun keeps its numbers plain.
fn is_spaceless(text) {
    var i = 0
    while i < text.len() {
        let code = ord(text.slice(i, i + 1))
        if (code >= 11904 and code <= 40959) or
           (code >= 43360 and code <= 43391) or
           (code >= 44032 and code <= 55295) or
           (code >= 3584 and code <= 3711) or
           (code >= 6016 and code <= 6143) or
           (code >= 4096 and code <= 4255) {
            return true
        }
        i = i + 1
    }
    return false
}

// Peel localized keywords off the front of a glued word. The host sends
// keys longest-first, so a longer keyword always wins. This mirrors the
// Python front end and deliberately does not call emit_word back: the
// keys are all hard aliases, soft aliases or English keywords, so the
// three tables below cover every one of them.
fn split_word(st, text, line, col) {
    let lang = st["lang"]
    let keys = lang["split"]
    var index = 0
    var plain = ""
    while index < text.len() {
        var matched = false
        var ki = 0
        while ki < keys.len() {
            let key = keys[ki]
            if key.len() > 0 and text.slice(index, index + key.len()) == key {
                if plain.len() > 0 {
                    add_token(st, "IDENT", plain, line,
                              col + index - plain.len())
                    plain = ""
                }
                if lang["soft"].has(key) {
                    add_token(st, "IDENT", lang["soft"].get(key), line,
                              col + index)
                } else {
                    if lang["hard"].has(key) {
                        add_token(st, lang["hard"].get(key), key, line,
                                  col + index)
                    } else {
                        if KEYWORDS.has(key) {
                            add_token(st, KEYWORDS.get(key), key, line,
                                      col + index)
                        } else {
                            add_token(st, "IDENT", key, line, col + index)
                        }
                    }
                }
                index = index + key.len()
                matched = true
                break
            }
            ki = ki + 1
        }
        if not matched {
            plain = plain + text.slice(index, index + 1)
            index = index + 1
        }
    }
    if plain.len() > 0 {
        add_token(st, "IDENT", plain, line, col + index - plain.len())
    }
}

// One identifier word. With a language pack the localized word keeps its
// own spelling in the token value but takes the English keyword's type;
// a soft keyword becomes an IDENT carrying its English name. Without a
// pack the word is never split, even in a spaceless script.
fn emit_word(st, text, line, col) {
    if text.len() == 0 {
        return
    }
    let lang = st["lang"]
    if lang != null and lang["code"] != null {
        if lang["soft"].has(text) {
            add_token(st, "IDENT", lang["soft"].get(text), line, col)
            return
        }
        if lang["hard"].has(text) {
            add_token(st, lang["hard"].get(text), text, line, col)
            return
        }
        if is_spaceless(text) {
            split_word(st, text, line, col)
            return
        }
    }
    if KEYWORDS.has(text) {
        add_token(st, KEYWORDS.get(text), text, line, col)
    } else {
        add_token(st, "IDENT", text, line, col)
    }
}

fn identifier(st) {
    let line = st["line"]
    let col = st["col"]
    let start = st["pos"]
    while is_alnum(peek_at(st, 0)) or peek_at(st, 0) == "_" {
        advance(st)
    }
    let text = st["source"].slice(start, st["pos"])
    emit_word(st, text, line, col)
}

fn operator(st) {
    let line = st["line"]
    let col = st["col"]
    let ch = advance(st)
    let three = ch + peek_at(st, 0) + peek_at(st, 1)
    if THREE_CHAR.has(three) {
        advance(st)
        advance(st)
        add_token(st, THREE_CHAR.get(three), three, line, col)
        return
    }
    let two = ch + peek_at(st, 0)
    if TWO_CHAR.has(two) {
        advance(st)
        add_token(st, TWO_CHAR.get(two), two, line, col)
        return
    }
    if ONE_CHAR.has(ch) {
        add_token(st, ONE_CHAR.get(ch), ch, line, col)
        return
    }
    throw "unexpected character '" + ch + "' at " + str(line) + ":" + str(col)
}

// Plain English entry point. Kept for the parser and checker, which
// tokenize source fragments that carry no language pack of their own.
export fn tokenize(source) {
    return tokenize_lang(source, null)
}

// The driver uses this one. `lang` is the host-provided localized-keyword
// table for this very file, or null when it has no `#lang:` directive.
// The word logic lives here in Bun; the host only supplies the data.
export fn tokenize_lang(source, lang) {
    let st = make_lexer(source, lang)
    while st["pos"] < st["source"].len() {
        let ch = peek_at(st, 0)
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" or ch == ";" {
            // A semicolon is an optional statement terminator; the grammar
            // already ends a statement when its expression ends.
            advance(st)
        } else {
            if ch == "#" or (ch == "/" and peek_at(st, 1) == "/") {
                while st["pos"] < st["source"].len() and peek_at(st, 0) != "\n" {
                    advance(st)
                }
            } else {
                if is_digit(ch) {
                    number(st)
                } else {
                    if ch == "\"" or ch == "'" {
                        if peek_at(st, 0) == ch and peek_at(st, 1) == ch and peek_at(st, 2) == ch {
                            triple_string_token(st, ch)
                        } else {
                            string_token(st, ch)
                        }
                    } else {
                        if ch == "f" and (peek_at(st, 1) == "\"" or peek_at(st, 1) == "'") {
                            fstring_token(st)
                        } else {
                            if is_alpha(ch) or ch == "_" {
                                identifier(st)
                            } else {
                                operator(st)
                            }
                        }
                    }
                }
            }
        }
    }
    add_token(st, "EOF", null, st["line"], st["col"])
    return st["tokens"]
}

